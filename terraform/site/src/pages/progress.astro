---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  allTrackables,
  categoryLabels,
  difficultyLabels,
  difficultyOrder,
} from "../data/trackables";
---

<BaseLayout title="Progress tracker">
  <section class="hero container tracker-hero">
    <h1>Progress tracker</h1>
    <p class="lead">Mark labs complete as you go. Follow <a href="/learn.html">lessons</a> or the <a href="https://github.com/Jacob-Idolor/Pet_Projects/blob/main/terraform/LEARNING-PATH.md" target="_blank" rel="noopener">learning path</a>: lesson → simulator → local lab → troubleshoot.</p>
  </section>

  <section class="container">
    <div class="stats-grid" id="stats-grid">
      <div class="stat-card stat-main">
        <span class="stat-value" id="stat-overall">0%</span>
        <span class="stat-label">Overall complete</span>
        <div class="progress-bar"><div class="progress-fill" id="bar-overall"></div></div>
      </div>
      <div class="stat-card">
        <span class="stat-value" id="stat-streak">0</span>
        <span class="stat-label">Day streak</span>
      </div>
      <div class="stat-card">
        <span class="stat-value" id="stat-done">0 / 0</span>
        <span class="stat-label">Tasks done</span>
      </div>
      <div class="stat-card">
        <span class="stat-value" id="stat-last">—</span>
        <span class="stat-label">Last practice</span>
      </div>
    </div>

    <div class="difficulty-section">
      <h2>By difficulty</h2>
      <div class="diff-bars" id="diff-bars"></div>
    </div>

    <div class="category-section">
      <h2>By category</h2>
      <div class="cat-bars" id="cat-bars"></div>
    </div>

    <div class="next-up" id="next-up" hidden>
      <h2>Suggested next</h2>
      <p id="next-up-text"></p>
    </div>
  </section>

  <section class="container tracker-controls">
    <div class="filter-bar" id="tracker-filters"></div>
    <div class="tracker-actions">
      <button type="button" class="btn btn-secondary" id="btn-export">Export backup</button>
      <button type="button" class="btn btn-secondary" id="btn-import">Import backup</button>
      <button type="button" class="btn btn-secondary btn-danger" id="btn-reset">Reset all</button>
    </div>
    <input type="file" id="import-file" accept="application/json" hidden />
  </section>

  <section class="container">
    <div class="task-list" id="task-list"></div>
  </section>

  <section class="container tracker-footer">
    <div class="callout">
      <p>
        <strong>Tip:</strong> Quizzes and simulator missions auto-check when you complete them in the browser.
        Local cluster labs — mark done manually when you finish the README steps.
      </p>
      <p id="cert-link-wrap" hidden>
        🎓 Core labs complete — <a href="/certificate.html">Get your certificate &amp; LinkedIn text →</a>
      </p>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ trackablesJson: JSON.stringify(allTrackables), categoryLabelsJson: JSON.stringify(categoryLabels), difficultyLabelsJson: JSON.stringify(difficultyLabels), difficultyOrderJson: JSON.stringify(difficultyOrder) }}>
  import {
    loadProgress,
    saveProgress,
    setComplete,
    setNote,
    syncAutoCompletions,
    exportProgress,
    importProgress,
    isComplete,
    countByDifficulty,
    countByCategory,
    emptyProgress,
  } from "../lib/progress-store";
  import { getCertificateStatus } from "../lib/certificate";

  const trackables = JSON.parse(trackablesJson);
  const categoryLabels = JSON.parse(categoryLabelsJson);
  const difficultyLabels = JSON.parse(difficultyLabelsJson);
  const difficultyOrder = JSON.parse(difficultyOrderJson);

  let progress = syncAutoCompletions(loadProgress());
  saveProgress(progress);

  let activeFilter = "all";

  function pct(done: number, total: number) {
    return total ? Math.round((done / total) * 100) : 0;
  }

  function renderStats() {
    const total = trackables.length;
    const done = trackables.filter((t) => isComplete(progress, t.id)).length;
    const overall = pct(done, total);

    document.getElementById("stat-overall")!.textContent = `${overall}%`;
    document.getElementById("bar-overall")!.style.width = `${overall}%`;
    document.getElementById("stat-streak")!.textContent = String(progress.streak);
    document.getElementById("stat-done")!.textContent = `${done} / ${total}`;
    document.getElementById("stat-last")!.textContent = progress.lastPracticeDay ?? "—";

    const diffBars = document.getElementById("diff-bars")!;
    const byDiff = countByDifficulty(trackables, progress);
    diffBars.innerHTML = difficultyOrder
      .map((d) => {
        const b = byDiff[d] ?? { done: 0, total: 0 };
        const p = pct(b.done, b.total);
        return `<div class="bar-row"><span class="bar-label">${difficultyLabels[d]} <strong>${b.done}/${b.total}</strong></span><div class="progress-bar"><div class="progress-fill fill-${d}" style="width:${p}%"></div></div></div>`;
      })
      .join("");

    const catBars = document.getElementById("cat-bars")!;
    const byCat = countByCategory(trackables, progress);
    catBars.innerHTML = Object.entries(byCat)
      .map(([cat, b]) => {
        const p = pct(b.done, b.total);
        return `<div class="bar-row"><span class="bar-label">${categoryLabels[cat] ?? cat} <strong>${b.done}/${b.total}</strong></span><div class="progress-bar"><div class="progress-fill" style="width:${p}%"></div></div></div>`;
      })
      .join("");

    const incomplete = trackables.filter((t) => !isComplete(progress, t.id));
    const order = { beginner: 0, intermediate: 1, advanced: 2 };
    incomplete.sort((a, b) => order[a.difficulty] - order[b.difficulty]);
    const next = incomplete[0];
    const nextUp = document.getElementById("next-up")!;
    if (next) {
      nextUp.hidden = false;
      const isExt = next.href.startsWith("http");
      document.getElementById("next-up-text")!.innerHTML = `Try <a href="${next.href}"${isExt ? ' target="_blank" rel="noopener"' : ""}><strong>${next.title}</strong></a> (${difficultyLabels[next.difficulty]}) — ${next.description}`;
    } else {
      nextUp.hidden = true;
      document.getElementById("cert-link-wrap")!.hidden = false;
    }

    const certStatus = getCertificateStatus(progress, trackables);
    if (certStatus.eligible) {
      document.getElementById("cert-link-wrap")!.hidden = false;
    }
  }

  function renderFilters() {
    const cats = ["all", ...new Set(trackables.map((t) => t.category))];
    const el = document.getElementById("tracker-filters")!;
    el.innerHTML = cats
      .map(
        (c) =>
          `<button type="button" class="filter-btn${c === activeFilter ? " active" : ""}" data-filter="${c}">${c === "all" ? "All tasks" : categoryLabels[c] ?? c}</button>`
      )
      .join("");
    el.querySelectorAll(".filter-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        activeFilter = (btn as HTMLElement).dataset.filter!;
        renderFilters();
        renderTasks();
      });
    });
  }

  function renderTasks() {
    const list = document.getElementById("task-list")!;
    const filtered =
      activeFilter === "all" ? trackables : trackables.filter((t) => t.category === activeFilter);

    list.innerHTML = filtered
      .map((t) => {
        const done = isComplete(progress, t.id);
        const rec = progress.completed[t.id];
        const isExt = t.href.startsWith("http");
        return `<article class="task-row${done ? " task-done" : ""}" data-id="${t.id}">
          <label class="task-check">
            <input type="checkbox" ${done ? "checked" : ""} data-complete />
            <span class="check-box"></span>
          </label>
          <div class="task-body">
            <div class="task-head">
              <strong>${t.title}</strong>
              <span class="badge badge-${t.difficulty}">${difficultyLabels[t.difficulty]}</span>
              <span class="badge badge-cat">${categoryLabels[t.category] ?? t.category}</span>
              ${t.time ? `<span class="task-time">${t.time}</span>` : ""}
            </div>
            <p class="task-desc">${t.description}</p>
            ${done ? `<textarea class="task-note" placeholder="Notes (optional)..." data-note rows="2">${rec?.note ?? ""}</textarea>` : ""}
            <a href="${t.href}" class="task-link"${isExt ? ' target="_blank" rel="noopener"' : ""}>Open →</a>
          </div>
        </article>`;
      })
      .join("");

    list.querySelectorAll("[data-complete]").forEach((input) => {
      input.addEventListener("change", (e) => {
        const row = (e.target as HTMLElement).closest(".task-row") as HTMLElement;
        const id = row.dataset.id!;
        progress = setComplete(progress, id, (e.target as HTMLInputElement).checked);
        saveProgress(progress);
        renderStats();
        renderTasks();
      });
    });

    list.querySelectorAll("[data-note]").forEach((ta) => {
      ta.addEventListener("blur", (e) => {
        const row = (e.target as HTMLElement).closest(".task-row") as HTMLElement;
        const id = row.dataset.id!;
        progress = setNote(progress, id, (e.target as HTMLTextAreaElement).value);
        saveProgress(progress);
      });
    });
  }

  document.getElementById("btn-export")!.addEventListener("click", () => {
    const blob = new Blob([exportProgress(progress)], { type: "application/json" });
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = `tf-lab-progress-${new Date().toISOString().slice(0, 10)}.json`;
    a.click();
  });

  document.getElementById("btn-import")!.addEventListener("click", () => {
    document.getElementById("import-file")!.click();
  });

  document.getElementById("import-file")!.addEventListener("change", async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    try {
      progress = importProgress(await file.text());
      saveProgress(progress);
      renderStats();
      renderTasks();
    } catch {
      alert("Could not import — invalid JSON file.");
    }
  });

  document.getElementById("btn-reset")!.addEventListener("click", () => {
    if (confirm("Reset all progress? This cannot be undone unless you exported a backup.")) {
      progress = emptyProgress();
      saveProgress(progress);
      renderStats();
      renderTasks();
    }
  });

  saveProgress(progress);
  renderStats();
  renderFilters();
  renderTasks();
</script>

<style>
  .tracker-hero {
    padding: 2.5rem 0 1.5rem;
    text-align: center;
  }
  .tracker-hero h1 { margin: 0 0 0.5rem; }
  .tracker-hero .lead {
    color: var(--muted);
    max-width: 32rem;
    margin: 0 auto;
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .stat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem;
    text-align: center;
  }
  .stat-main { grid-column: span 1; }
  @media (min-width: 640px) {
    .stat-main { grid-column: span 2; }
  }
  .stat-value {
    display: block;
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text);
  }
  .stat-label {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .progress-bar {
    height: 8px;
    background: #0a0e12;
    border-radius: 4px;
    margin-top: 0.75rem;
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    background: var(--accent);
    border-radius: 4px;
    transition: width 0.3s;
  }
  .fill-beginner { background: var(--success); }
  .fill-intermediate { background: var(--warn); }
  .fill-advanced { background: #f87171; }
  .difficulty-section,
  .category-section {
    margin-bottom: 2rem;
  }
  .difficulty-section h2,
  .category-section h2,
  .next-up h2 {
    font-size: 1rem;
    margin: 0 0 0.75rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .bar-row { margin-bottom: 0.6rem; }
  .bar-label {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 0.25rem;
  }
  .next-up {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    margin-bottom: 2rem;
  }
  .next-up p { margin: 0; color: var(--muted); }
  .tracker-controls {
    margin-bottom: 1.5rem;
  }
  .tracker-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .btn-danger {
    border-color: #7f1d1d;
    color: #fca5a5;
  }
  .task-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-bottom: 3rem;
  }
  .task-row {
    display: flex;
    gap: 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    transition: border-color 0.15s;
  }
  .task-row.task-done {
    border-color: rgba(34, 197, 94, 0.35);
    opacity: 0.92;
  }
  .task-check {
    flex-shrink: 0;
    cursor: pointer;
    padding-top: 0.15rem;
  }
  .task-check input { display: none; }
  .check-box {
    display: block;
    width: 22px;
    height: 22px;
    border: 2px solid var(--border);
    border-radius: 6px;
    transition: all 0.15s;
  }
  .task-check input:checked + .check-box {
    background: var(--success);
    border-color: var(--success);
  }
  .task-check input:checked + .check-box::after {
    content: "✓";
    display: block;
    text-align: center;
    color: #fff;
    font-size: 14px;
    line-height: 18px;
  }
  .task-body { flex: 1; min-width: 0; }
  .task-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }
  .task-desc {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .task-time { font-size: 0.75rem; color: var(--muted); }
  .task-link { font-size: 0.85rem; }
  .task-note {
    width: 100%;
    background: #0a0e12;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    font-family: inherit;
    font-size: 0.85rem;
    padding: 0.5rem 0.75rem;
    margin-bottom: 0.5rem;
    resize: vertical;
  }
  .badge-beginner { color: var(--success); font-size: 0.7rem; }
  .badge-intermediate { color: var(--warn); font-size: 0.7rem; }
  .badge-advanced { color: #f87171; font-size: 0.7rem; }
  .badge-cat { color: #38bdf8; font-size: 0.7rem; }
  .tracker-footer { padding-bottom: 3rem; }
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .filter-btn {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--muted);
    padding: 0.45rem 1rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
  }
  .filter-btn.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
</style>
