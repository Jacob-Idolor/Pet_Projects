---
import type { Scenario } from "../data/scenarios";

interface Props {
  scenario: Scenario;
}

const { scenario } = Astro.props;
---

<article class="scenario-card">
  <div class="scenario-header">
    <span class={`badge diff-${scenario.difficulty}`}>{scenario.difficulty}</span>
  </div>
  <h3>{scenario.title}</h3>
  <p class="symptom">{scenario.description}</p>
  <p class="skill"><strong>Symptoms:</strong> {scenario.symptoms.join(" · ")}</p>
  <details class="scenario-details">
    <summary>Commands (spoiler)</summary>
    <ul>
      {scenario.commands.map((c) => <li><code>{c}</code></li>)}
    </ul>
  </details>
  <a class="btn btn-primary" href={scenario.href}>Practice scenario →</a>
</article>

<style>
  .scenario-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .scenario-header { display: flex; gap: 0.5rem; }
  .diff-beginner { color: var(--success); }
  .diff-intermediate { color: var(--warn); }
  .diff-advanced { color: #f87171; }
  .scenario-card h3 { margin: 0; font-size: 1.05rem; }
  .symptom { color: var(--muted); font-size: 0.9rem; margin: 0; }
  .skill { font-size: 0.85rem; color: var(--muted); margin: 0; }
  .scenario-details { font-size: 0.85rem; color: var(--muted); }
  .scenario-details summary { cursor: pointer; color: var(--accent); }
  .scenario-card .btn { margin-top: auto; text-align: center; }
</style>
