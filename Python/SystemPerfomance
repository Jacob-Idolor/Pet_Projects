    def setup_activity_monitoring(self):
        """Setup user activity monitoring"""
        def on_user_activity(event=None):
            self.last_user_activity = time.time()
            if not self.manual_paused and self.auto_mode:
                self.update_status("User Active")
        
        self.root.bind_all('<Key>', on_user_activity)
        self.root.bind_all('<Motion>', on_user_activity)
        self.root.bind_all('<Button>', on_user_activity)
    
    def is_within_work_hours(self):
        """Check if current time is within configured work hours"""
        tz = pytz.timezone(self.settings["timezone"])
        now = datetime.now(tz)
        start = now.replace(hour=self.settings["work_start_hour"], 
                           minute=self.settings["work_start_minute"], 
                           second=0, microsecond=0)
        end = now.replace(hour=self.settings["work_end_hour"], 
                         minute=self.settings["work_end_minute"], 
                         second=0, microsecond=0)
        return start <= now <= end
    
    def update_status(self, message):
        """Update the overall status display"""
        self.status_vars['overall'].set(message)
    
    def show_notification(self, message, msg_type="info"):
        """Show notification if enabled in settings (more discreet)"""
        if not self.settings.get("notifications", True):
            return
        if message == self.last_notification:
            return  # Avoid duplicate notifications
        self.last_notification = message
        
        # Only show critical errors, suppress info messages for discretion
        if msg_type == "error":
            messagebox.showerror("System Error", message)
        elif msg_type == "warning":
            messagebox.showwarning("System Warning", message)
        # Skip info messages for better discretion
    
    def start_script(self, name, script):
        """Start a specific script"""
        if not self.auto_mode and not self.is_within_work_hours():
            self.show_notification("Scripts can only be started during work hours in auto mode")
            return
            
        if self.manual_paused:
            self.show_notification("Cannot start scripts while manually paused")
            return
            
        if name in self.processes and self.processes[name].poll() is None:
            self.show_notification(f"{name.capitalize()} script is already running")
            return
        
        # Check if script files exist
        if not os.path.exists(script):
            self.show_notification(f"Script file '{script}' not found", "error")
            return
        
        try:
            # Start the process
            self.processes[name] = subprocess.Popen(
                ["python", script],
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1,
                cwd=os.path.dirname(os.path.abspath(__file__))
            )
            
            self.status_vars[name].set('On')
            self.update_status(f"{name.capitalize()} active")
            
            # Only show output window in debug mode (disabled by default)
            if self.settings.get("debug_mode", False):
                self.show_output_window(name)
            
        except FileNotFoundError:
            self.show_notification("Python not found. Please ensure Python is installed and in PATH", "error")
        except Exception as e:
            self.show_notification(f"Failed to start {name} script: {e}", "error")
    
    def stop_script(self, name):
        """Stop a specific script"""
        if name in self.processes and self.processes[name].poll() is None:
            try:
                self.processes[name].terminate()
                self.processes[name].wait(timeout=5)
                self.status_vars[name].set('Off')
                self.update_status(f"{name.capitalize()} stopped")
            except subprocess.TimeoutExpired:
                self.processes[name].kill()
                self.status_vars[name].set('Off')
                self.update_status(f"{name.capitalize()} stopped")
            except Exception as e:
                self.show_notification(f"Error stopping {name} script: {e}", "error")
    
    def start_all_scripts(self):
        """Start all optimization modules"""
        self.start_script('mouse', 'Mousey.py')
        self.start_script('key', 'mousey2.py')
    
    def pause_all_scripts(self):
        """Pause all optimization modules (manual pause)"""
        self.manual_paused = True
        for name in list(self.processes.keys()):
            self.stop_script(name)
        self.update_status("Paused")
    
    def stop_all_scripts(self):
        """Stop all optimization modules"""
        self.manual_paused = False
        for name in list(self.processes.keys()):
            self.stop_script(name)
        self.update_status("Stopped")
    
    def toggle_auto_mode(self):
        """Toggle between auto and manual mode"""
        self.auto_mode = self.auto_mode_var.get()
        if self.auto_mode:
            self.manual_paused = False
            self.update_status("Auto On")
        else:
            self.update_status("Manual")
    
    def show_output_window(self, name):
        """Show output window for a script"""
        if name in self.output_texts:
            try:
                self.output_texts[name].tkraise()
                return
            except:
                pass
        
        output_win = tk.Toplevel(self.root)
        output_win.title(f"{name.capitalize()} Output")
        output_win.geometry("600x400")
        
        # Create text widget with scrollbar
        text_frame = ttk.Frame(output_win)
        text_frame.pack(fill=tk.BOTH, expand=True, padx=10, pady=10)
        
        output_text = tk.Text(text_frame, wrap=tk.WORD, state='disabled')
        scrollbar = ttk.Scrollbar(text_frame, orient=tk.VERTICAL, command=output_text.yview)
        output_text.configure(yscrollcommand=scrollbar.set)
        
        output_text.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        scrollbar.pack(side=tk.RIGHT, fill=tk.Y)
        
        self.output_texts[name] = output_text
        
        # Start reading output in a separate thread
        def read_output():
            try:
                if name in self.processes:
                    process = self.processes[name]
                    for line in iter(process.stdout.readline, ''):
                        if not line:
                            break
                        self.root.after(0, lambda l=line: self.append_output(name, l))
            except Exception as e:
                self.root.after(0, lambda: self.show_notification(f"Output error: {e}", "error"))
        
        threading.Thread(target=read_output, daemon=True).start()
    
    def append_output(self, name, text):
        """Append text to output window"""
        if name in self.output_texts:
            try:
                output_text = self.output_texts[name]
                output_text.configure(state='normal')
                output_text.insert(tk.END, text)
                output_text.see(tk.END)
                output_text.configure(state='disabled')
            except:
                pass

    
    def auto_manage_scripts(self):
        """Automatically manage scripts 24/7, with random stop/sleep at end of work hours"""
        if not self.auto_mode:
            self.root.after(1000, self.auto_manage_scripts)
            return
        
        running = any(proc.poll() is None for proc in self.processes.values())
        idle_time = time.time() - self.last_user_activity
        now = datetime.now(pytz.timezone(self.settings["timezone"]))
        end_hour = self.settings["work_end_hour"]
        end_minute = self.settings["work_end_minute"]
        end_time = now.replace(hour=end_hour, minute=end_minute, second=0, microsecond=0)
        random_sleep_window = timedelta(minutes=15)
        
        # Check if we're in the stop window (e.g., 4:30pm - 4:45pm)
        if now >= end_time and now < end_time + random_sleep_window:
            if not hasattr(self, "_random_sleep_scheduled"):
                # Schedule random sleep only once per day
                offset = random.randint(0, 15 * 60)  # 0-15 minutes in seconds
                self._random_sleep_scheduled = True
                self.root.after(offset * 1000, self._stop_and_sleep)
                self.update_status(f"Sleep scheduled in {offset//60} min")
        elif now >= end_time + random_sleep_window:
            # After the window, ensure scripts are stopped (already slept)
            if running:
                for name in list(self.processes.keys()):
                    self.stop_script(name)
                self.update_status("Stopped for today")
            self.user_active = False
        else:
            # Reset the sleep schedule flag when a new day starts (before end time)
            if hasattr(self, "_random_sleep_scheduled"):
                self._random_sleep_scheduled = False
            
            # Run 24/7 logic - ignore work hours, just check user activity
            if self.manual_paused:
                if running:
                    for name in list(self.processes.keys()):
                        self.stop_script(name)
                self.update_status("Paused")
            elif idle_time < self.settings["idle_timeout"]:
                # User is active, pause scripts
                if running and not self.user_active:
                    for name in list(self.processes.keys()):
                        self.stop_script(name)
                    self.update_status("User Active")
                self.user_active = True
            else:
                # User is idle, run scripts 24/7
                if not running and self.settings["auto_start"]:
                    self.start_script('mouse', 'Mousey.py')
                    self.start_script('key', 'mousey2.py')
                    self.update_status("Active 24/7")
                elif running:
                    self.update_status("Running")
                self.user_active = False
        
        # Schedule next check
        self.root.after(1000, self.auto_manage_scripts)
    
    def _stop_and_sleep(self):
        """Stop all scripts and put computer to sleep"""
        for name in list(self.processes.keys()):
            self.stop_script(name)
        self.update_status("Sleeping now")
        try:
            # Windows sleep command
            subprocess.run(["rundll32.exe", "powrprof.dll,SetSuspendState", "0,1,0"], shell=True)
        except Exception as e:
            self.show_notification(f"Failed to sleep: {e}", "error")
    
