# .gitignore — Sports Betting Dashboard

# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.Python
build/
dist/
*.egg-info/
*.egg

# ── Virtual environments ──────────────────────────────────────────
.venv/
venv/
ENV/
env/

# ── Streamlit: commit .streamlit/config.toml, never commit secrets ─
.streamlit/secrets.toml
secrets.toml

# ── Private / internal (business plan, monetization, roadmap — do not push) ─
private/

# ── Personal data files (transfer manually, not via git) ──────────
subscribers.csv
picks_history.json
email_subscribers.csv
email_preview.html
feedback.json

# ── Old backups / archives ────────────────────────────────────────
*.zip

# ── IDE / editor ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS files ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Environment variables ─────────────────────────────────────────
.env
.env.local
.env.production

# ── Logs / temp ───────────────────────────────────────────────────
*.log
*.tmp
*.temp
