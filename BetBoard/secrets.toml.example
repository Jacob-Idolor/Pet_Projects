# ─────────────────────────────────────────────────────────────────────────────
# .streamlit/secrets.toml  —  BetBoard local secrets
# !! DO NOT COMMIT THIS FILE !!  It is listed in .gitignore.
# On Streamlit Cloud: add these as App Secrets in the dashboard instead.
# ─────────────────────────────────────────────────────────────────────────────

# The Odds API  (free tier: https://the-odds-api.com)
ODDS_API_KEY = "YOUR_ODDS_API_KEY_HERE"

# Resend  (free 3 000 emails/month: https://resend.com)
# Leave blank if you prefer Brevo
RESEND_API_KEY = ""

# Brevo / Sendinblue  (free 9 000 emails/month: https://www.brevo.com)
# Leave blank if you prefer Resend
BREVO_API_KEY = ""

# (Optional) Sender email for Brevo
BREVO_SENDER_EMAIL = ""
