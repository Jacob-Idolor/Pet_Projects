##### BetBoard local environment template
#
# Copy this file to ".env" and fill in real values.
# The real ".env" is gitignored and should NEVER be committed.
#
# These variables are used by:
# - Streamlit app (via environment / Streamlit Cloud secrets)
# - CLI scripts like send_daily_pick.py

ODDS_API_KEY=your_odds_api_key_here
RESEND_API_KEY=your_resend_api_key_here
BREVO_API_KEY=your_brevo_api_key_here
NEWSLETTER_FROM="BetBoard Picks <picks@yourdomain.com>"

