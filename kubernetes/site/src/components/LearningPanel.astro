---
import type { ModuleMeta } from "../data/learning-meta";

interface Props {
  meta: ModuleMeta;
  moduleOrder: number;
}

const { meta, moduleOrder } = Astro.props;
---

<aside class="learning-panel">
  {meta.prerequisites.length > 0 && (
    <div class="panel-block">
      <h3>Before you start</h3>
      <ul>
        {meta.prerequisites.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  )}

  <div class="panel-block panel-takeaways">
    <h3>Key takeaways</h3>
    <ul>
      {meta.keyTakeaways.map((t) => <li>{t}</li>)}
    </ul>
  </div>

  <div class="panel-block panel-labs">
    <h3>Practice next</h3>
    <ul class="lab-links">
      {meta.browserLab && (
        <li><a href={meta.browserLab}>Browser lab →</a></li>
      )}
      {meta.localLab && (
        <li>
          <a href={meta.localLab.href} target="_blank" rel="noopener">{meta.localLab.title} →</a>
          {meta.localLab.command && <code>{meta.localLab.command}</code>}
        </li>
      )}
    </ul>
  </div>

  <div class="panel-block">
    <h3>Reflect (write in Tracker notes)</h3>
    <ul>
      {meta.reflection.map((r) => <li>{r}</li>)}
    </ul>
  </div>

  <details class="panel-block panel-mistakes">
    <summary>Common mistakes to avoid</summary>
    <ul>
      {meta.commonMistakes.map((m) => <li>{m}</li>)}
    </ul>
  </details>
</aside>

<style>
  .learning-panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.25rem 1.5rem;
    margin: 2rem 0;
  }
  .panel-block {
    margin-bottom: 1.25rem;
  }
  .panel-block:last-child {
    margin-bottom: 0;
  }
  .panel-block h3 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    margin: 0 0 0.5rem;
  }
  .panel-block ul {
    margin: 0;
    padding-left: 1.2rem;
  }
  .panel-block li {
    margin-bottom: 0.35rem;
    font-size: 0.95rem;
    color: var(--text);
  }
  .panel-takeaways li {
    color: var(--text);
  }
  .lab-links {
    list-style: none;
    padding: 0 !important;
  }
  .lab-links li {
    margin-bottom: 0.5rem;
  }
  .lab-links code {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.8rem;
    background: #0a0e12;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    color: var(--success);
  }
  .panel-mistakes summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--warn);
    font-size: 0.9rem;
  }
  .panel-mistakes ul {
    margin-top: 0.5rem;
  }
</style>
