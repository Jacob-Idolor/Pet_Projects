---
import BaseLayout from "../../layouts/BaseLayout.astro";

const labs = [
  { slug: "lab-01-first-pod", title: "First pod", level: "L1", desc: "Apply YAML, logs, exec, port-forward" },
  { slug: "lab-02-deployments-services", title: "Deployments & services", level: "L1–L2", desc: "Scale, ClusterIP, rollout/rollback" },
  { slug: "lab-03-config-secrets", title: "ConfigMaps & secrets", level: "L2", desc: "Env vars, volumes, config updates" },
  { slug: "lab-04-networking-ingress", title: "Networking & ingress", level: "L2", desc: "Ingress controller, routing, debug endpoints" },
  { slug: "lab-05-storage", title: "Storage", level: "L3", desc: "PVC, persistent data, pending pods" },
  { slug: "lab-06-rbac", title: "RBAC", level: "L3", desc: "ServiceAccounts, Roles, auth can-i" },
  { slug: "lab-07-helm", title: "Helm", level: "L3", desc: "Install, upgrade, rollback charts" },
  { slug: "lab-prometheus-grafana", title: "Observability", level: "L5", desc: "Prometheus + Grafana stack", path: "observability/lab-prometheus-grafana" },
];
const repoBase = "https://github.com/Jacob-Idolor/Pet_Projects/tree/main/kubernetes";
---

<BaseLayout title="Labs" description="Hands-on Kubernetes labs — run locally with kind or minikube.">
  <section class="hero container prose">
    <h1>Labs</h1>
    <p class="lead">
      Each lab runs on <strong>your local cluster</strong>. Clone the repo, run
      <code>kubernetes/scripts/setup-kind.ps1</code>, then follow the README in each lab folder.
    </p>

    <h2>Before you start</h2>
    <ul>
      <li><a href="https://github.com/Jacob-Idolor/Pet_Projects/blob/main/kubernetes/SETUP.md">Local setup guide</a></li>
      <li>Docker Desktop + kind + kubectl</li>
      <li>~30–60 minutes per lab</li>
    </ul>

    <h2>Lab index</h2>
    <div class="card-grid">
      {labs.map((lab, i) => (
        <article class="card">
          <span class="badge">{lab.level}</span>
          <h3>Lab {String(i + 1).padStart(2, "0")} — {lab.title}</h3>
          <p>{lab.desc}</p>
          <p>
            <a href={`${repoBase}/${lab.path ?? `labs/${lab.slug}`}`}>
              Open on GitHub →
            </a>
          </p>
        </article>
      ))}
    </div>

    <div class="callout">
      <p>
        Full step-by-step instructions live in the GitHub repo (linked above). This site is the map;
        your terminal is the classroom.
      </p>
    </div>
  </section>
</BaseLayout>
