---
import BaseLayout from "../layouts/BaseLayout.astro";
import KubectlTerminal from "../components/KubectlTerminal.astro";
---

<BaseLayout title="Practice — ImagePullBackOff">
  <section class="hero container prose">
    <h1>Scenario: ImagePullBackOff</h1>
    <p class="lead">
      Pod can't pull <code>nginx:doesnotexist-tag-999</code>. Use
      <code>kubectl describe pod broken-app</code> and check Events.
    </p>
  </section>
  <section class="container">
    <KubectlTerminal cluster="imagepull" height="380px" />
  </section>
  <section class="container prose">
    <div class="callout">
      <p><strong>Fix:</strong> Use a valid tag like <code>nginx:1.25</code>. On kind, build locally and <code>kind load docker-image myapp:1.0 --name practice</code>.</p>
    </div>
  </section>
</BaseLayout>
