---
import BaseLayout from "../layouts/BaseLayout.astro";
import KubectlTerminal from "../components/KubectlTerminal.astro";
import AdSlot from "../components/AdSlot.astro";
import { missions } from "../lib/kubectl-sim";
import { scenariosByType } from "../data/scenarios";
---

<BaseLayout title="Practice" description="Simulated kubectl terminal — practice Kubernetes commands in your browser, no install.">
  <section class="hero container prose">
    <h1>Practice kubectl</h1>
    <p class="lead">
      A <strong>simulated cluster</strong> in your browser. Learn commands, debug scenarios, and build muscle memory —
      then replay on a real local cluster with <code>make local-lab</code>.
    </p>
  </section>

  <section class="container">
    <KubectlTerminal cluster="default" height="380px" />
  </section>

  <section class="container prose">
    <h2>Guided missions</h2>
    <p>Complete these in the terminal above. Progress saves in your browser automatically.</p>
    <div class="card-grid">
      {missions.map((m) => (
        <article class="card">
          <h3>{m.title}</h3>
          <p>{m.hint}</p>
        </article>
      ))}
    </div>

    <h2>Kubernetes scenarios</h2>
    <p>Practice common on-call problems — or see all scenarios on the <a href="/troubleshoot.html">Troubleshoot hub</a>.</p>
    <div class="cta-row">
      <a class="btn btn-secondary" href="/practice.html">Default cluster</a>
      <a class="btn btn-secondary" href="/practice-crash.html">CrashLoopBackOff</a>
      <a class="btn btn-secondary" href="/practice-broken.html">Broken endpoints</a>
      <a class="btn btn-secondary" href="/practice-imagepull.html">ImagePullBackOff</a>
      <a class="btn btn-secondary" href="/practice-pending.html">Pod Pending</a>
    </div>

    <AdSlot slot="practice-bottom" />

    <div class="callout">
      <p>
        <strong>Also practice Docker:</strong> <a href="/docker.html">Docker fundamentals</a> has its own simulator
        for <code>docker ps</code>, <code>logs</code>, and container debugging.
      </p>
    </div>
  </section>
</BaseLayout>
