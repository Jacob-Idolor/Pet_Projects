---
import BaseLayout from "../layouts/BaseLayout.astro";
import KubectlTerminal from "../components/KubectlTerminal.astro";
import AdSlot from "../components/AdSlot.astro";
import { missions } from "../lib/kubectl-sim";
---

<BaseLayout title="Practice" description="Simulated kubectl terminal — practice Kubernetes commands in your browser, no install.">
  <section class="hero container prose">
    <h1>Practice kubectl</h1>
    <p class="lead">
      A <strong>simulated cluster</strong> in your browser. Learn commands, debug scenarios, and build muscle memory —
      no Docker, no kind, no downloads. When you're ready for production, you'll understand what each command does.
    </p>
  </section>

  <section class="container">
    <KubectlTerminal cluster="default" height="380px" />
  </section>

  <section class="container prose">
    <h2>Guided missions</h2>
    <p>Complete these in the terminal above. Progress saves in your browser automatically.</p>
    <div class="card-grid">
      {missions.map((m) => (
        <article class="card">
          <h3>{m.title}</h3>
          <p>{m.hint}</p>
        </article>
      ))}
    </div>

    <h2>Scenario clusters</h2>
    <p>Switch cluster state to practice different situations:</p>
    <div class="cta-row">
      <a class="btn btn-secondary" href="/practice.html">Default cluster</a>
      <a class="btn btn-secondary" href="/practice-broken.html">Broken endpoints</a>
      <a class="btn btn-secondary" href="/practice-crash.html">CrashLoopBackOff</a>
    </div>

    <AdSlot slot="practice-bottom" />

    <div class="callout">
      <p>
        <strong>Simulation vs real:</strong> This teaches concepts and commands. Before production deploys,
        you'll eventually practice on a real local cluster — but you can learn 80% here for free.
      </p>
    </div>
  </section>
</BaseLayout>
