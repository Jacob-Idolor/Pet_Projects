---
import BaseLayout from "../layouts/BaseLayout.astro";
import AdSlot from "../components/AdSlot.astro";
---

<BaseLayout title="Home">
  <section class="hero container">
    <span class="badge">Free · Browser-based · No install</span>
    <h1>Learn Kubernetes in your browser</h1>
    <p class="lead">
      Interactive modules, simulated kubectl, and quizzes — understand containers and Kubernetes
      fundamentals before you ever touch a real cluster. Built to share, built to scale with you.
    </p>
    <div class="cta-row">
      <a class="btn btn-primary" href="/learn.html">Start learning</a>
      <a class="btn btn-secondary" href="/practice.html">Open kubectl simulator</a>
    </div>
  </section>

  <section class="container">
    <AdSlot slot="home-top" />
  </section>

  <section class="container card-grid">
    <article class="card">
      <h3>📖 7 modules</h3>
      <p>Containers → Pods → Deployments → Config → Networking → Storage → Production patterns.</p>
    </article>
    <article class="card">
      <h3>💻 Simulated kubectl</h3>
      <p>Practice get, describe, logs, endpoints — scenarios like CrashLoopBackOff and broken Services.</p>
    </article>
    <article class="card">
      <h3>✅ Quizzes</h3>
      <p>Check understanding after each module. Progress saved in your browser.</p>
    </article>
    <article class="card">
      <h3>☁️ Host on AWS</h3>
      <p>Static site on S3 + CloudFront (~$1–5/mo). No EKS. No cloud clusters for learners.</p>
    </article>
  </section>

  <section class="container">
    <div class="callout">
      <p>
        <strong>How this works:</strong> You learn concepts and commands here first.
        When you're ready to deploy professionally, you'll know <em>why</em> each kubectl command matters —
        then practice on a real local cluster optional.
      </p>
    </div>
  </section>
</BaseLayout>
