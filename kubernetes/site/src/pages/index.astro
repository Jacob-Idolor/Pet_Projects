---
import BaseLayout from "../layouts/BaseLayout.astro";
import AdSlot from "../components/AdSlot.astro";
import ConceptDiagram from "../components/ConceptDiagram.astro";
import DockerPipelineDiagram from "../components/DockerPipelineDiagram.astro";
---

<BaseLayout title="Home">
  <section class="hero container hero-gradient">
    <span class="badge">Open source · Resume-ready · Shareable</span>
    <h1>Your Kubernetes & Docker learning lab</h1>
    <p class="lead">
      Interactive modules, Docker and kubectl simulators, troubleshooting scenarios,
      and real hands-on labs — run in the browser or on localhost. Host on AWS when you're ready to share.
    </p>
    <div class="cta-row">
      <a class="btn btn-primary" href="/docker.html">Start with Docker</a>
      <a class="btn btn-secondary" href="/learn.html">Kubernetes modules</a>
      <a class="btn btn-secondary" href="/troubleshoot.html">Troubleshoot</a>
    </div>
  </section>

  <section class="container">
    <AdSlot slot="home-top" />
  </section>

  <section class="container">
    <DockerPipelineDiagram />
  </section>

  <section class="container">
    <ConceptDiagram />
  </section>

  <section class="container card-grid">
    <article class="card card-highlight">
      <h3>🐳 Docker simulator</h3>
      <p>docker ps, logs, inspect, build — container fundamentals with guided missions.</p>
      <a class="btn btn-primary card-link" href="/docker.html">Practice Docker →</a>
    </article>
    <article class="card">
      <h3>📖 7 K8s modules</h3>
      <p>Pods → Deployments → Config → Networking → Storage → Production patterns.</p>
    </article>
    <article class="card">
      <h3>🔧 6 troubleshoot scenarios</h3>
      <p>CrashLoop, ImagePull, Pending, broken endpoints, exited containers, wrong ports.</p>
    </article>
    <article class="card">
      <h3>🖥️ Local + AWS</h3>
      <p>kind cluster for real YAML labs. Terraform for S3 + CloudFront hosting.</p>
    </article>
  </section>

  <section class="container">
    <div class="callout">
      <p>
        <strong>Learning loop:</strong> Browser simulator → quiz → <code>make docker-lab</code> →
        <code>make local-lab</code> → break/fix scenarios → track in Progress.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-gradient {
    background: radial-gradient(ellipse at 20% 0%, rgba(59, 130, 246, 0.12) 0%, transparent 55%),
                radial-gradient(ellipse at 80% 0%, rgba(56, 189, 248, 0.08) 0%, transparent 50%);
    border-radius: 0 0 16px 16px;
    margin-bottom: 1rem;
  }
  .card-highlight {
    border-color: #38bdf8;
    background: linear-gradient(135deg, var(--surface) 0%, #121a28 100%);
  }
  .card-link {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.9rem;
  }
</style>
