---
import BaseLayout from "../../layouts/BaseLayout.astro";
import KubectlTerminal from "../../components/KubectlTerminal.astro";
import DockerTerminal from "../../components/DockerTerminal.astro";
import Quiz from "../../components/Quiz.astro";
import AdSlot from "../../components/AdSlot.astro";
import DockerPipelineDiagram from "../../components/DockerPipelineDiagram.astro";
import LearningPanel from "../../components/LearningPanel.astro";
import LessonStep from "../../components/LessonStep.astro";
import { modules, getModule, phaseLabels } from "../../data/modules";
import { moduleMeta } from "../../data/learning-meta";

export function getStaticPaths() {
  return modules.map((m) => ({ params: { id: m.id } }));
}

const { id } = Astro.params;
const mod = getModule(id!);
if (!mod) throw new Error(`Module not found: ${id}`);
const prev = modules.find((m) => m.order === mod.order - 1);
const next = modules.find((m) => m.order === mod.order + 1);
const meta = moduleMeta[mod.id];
const phaseInfo = phaseLabels[mod.phase];
const phaseLessons = modules.filter((m) => m.phase === mod.phase);
const lessonInPhase = phaseLessons.findIndex((m) => m.id === mod.id) + 1;
const showPipeline = mod.phase === "containers" && mod.order <= 3;
---

<BaseLayout title={mod.title} description={mod.subtitle}>
  <section class="hero container prose">
    <span class="badge">{phaseInfo.title} · Lesson {lessonInPhase} of {phaseLessons.length}</span>
    <h1>{mod.title}</h1>
    <p class="lead">{mod.subtitle}</p>
    <p class="learn-flow"><strong>Flow:</strong> Read each step → try commands in the terminal → quick quiz → <a href="/progress.html">Tracker</a></p>
  </section>

  {meta && (
    <section class="container">
      <LearningPanel meta={meta} moduleOrder={mod.order} />
    </section>
  )}

  <section class="container">
    {mod.sections.map((s, i) => (
      <LessonStep
        heading={s.heading}
        body={s.body}
        type={s.type}
        tryCommand={s.tryCommand}
        index={i + 1}
      />
    ))}

    {showPipeline && <DockerPipelineDiagram />}

    <AdSlot slot={`module-${mod.id}-mid`} />

    <div class="practice-goal-box">
      <strong>Practice goal:</strong> {mod.practiceGoal}
    </div>
  </section>

  <section class="container">
    {mod.terminal === "docker" ? (
      <DockerTerminal cluster="default" height="340px" />
    ) : (
      <KubectlTerminal cluster={mod.cluster} height="340px" />
    )}
  </section>

  <section class="container prose">
    <h2 class="quiz-heading">Quick check ({mod.quiz.length} question{mod.quiz.length > 1 ? "s" : ""})</h2>
    <Quiz questions={mod.quiz} moduleId={mod.id} compact />

    <nav class="module-nav">
      {prev ? <a href={`/modules/${prev.id}.html`}>← {prev.title}</a> : <a href="/learn.html">All lessons</a>}
      {next ? <a href={`/modules/${next.id}.html`}>{next.title} →</a> : <a href="/practice.html">Practice →</a>}
    </nav>
  </section>
</BaseLayout>

<style>
  .module-nav {
    display: flex;
    justify-content: space-between;
    margin: 2rem 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .learn-flow {
    font-size: 0.9rem;
    color: var(--muted);
    margin-top: 0.75rem;
  }
  .practice-goal-box {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .practice-goal-box strong { color: var(--text); }
  .quiz-heading {
    font-size: 1rem;
    margin-bottom: 0.75rem;
  }
</style>
