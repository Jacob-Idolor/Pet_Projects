---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Learn Kubernetes and containers in your browser — simulated practice, no install required." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | K8s Practice Lab</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Google AdSense: paste your script after approval -->
    <!-- <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXX" crossorigin="anonymous"></script> -->
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="logo" href="/">☸ K8s Practice Lab</a>
        <nav>
          <a href="/learn.html">Learn</a>
          <a href="/practice.html">Practice</a>
          <a href="/get-started.html">Get started</a>
          <a href="/progress.html">Progress</a>
          <a href="/about.html">About</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>
          Browser + local Kubernetes learning — simulated practice and real kind labs.
          <a href="/privacy.html">Privacy</a> ·
          <a href="https://github.com/Jacob-Idolor/Pet_Projects" target="_blank" rel="noopener">GitHub</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
