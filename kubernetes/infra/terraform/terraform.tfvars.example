# Copy to terraform.tfvars and edit before terraform apply.
# NEVER commit terraform.tfvars (contains email / account hints).

aws_profile  = "pet-projects"
aws_region   = "us-west-2"

project_name     = "k8s-practice"

# REQUIRED: must match IAM policy prefix (pet-projects-*)
required_bucket_prefix = "pet-projects-"
site_bucket_name       = "pet-projects-jacob-k8s-lab"

# REQUIRED: lock Terraform to YOUR account
# Get ID: aws sts get-caller-identity --profile pet-projects
allowed_account_ids = ["123456789012"]

# Cheapest path: CloudFront URL only (no Route53 charges)
enable_custom_domain = false

# Budget email alerts (set enable_budget = false if apply fails on permissions)
enable_budget        = true
budget_alert_email   = "you@example.com"
monthly_budget_usd   = 5
max_monthly_budget_usd = 25

# Cost safeguards (prevent_destroy is hardcoded true in main.tf)
cloudfront_price_class = "PriceClass_100"
