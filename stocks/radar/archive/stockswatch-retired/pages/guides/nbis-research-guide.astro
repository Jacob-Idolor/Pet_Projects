---
import BaseLayout from "../../layouts/BaseLayout.astro";
import profile from "../../data/nbis-profile.json";

const base = import.meta.env.BASE_URL;
const site = Astro.site ? String(Astro.site).replace(/\/$/, "") : "";
const description = "A practical guide to reading the StocksWatch NBIS research desk: freshness, fundamentals, valuation assumptions, risks, and primary sources.";
const guideUrl = site ? `${site}/guides/nbis-research-guide.html` : "";
const structuredData = site
  ? {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Article",
          "@id": `${guideUrl}#article`,
          headline: "How to read the NBIS research desk",
          description,
          url: guideUrl,
          mainEntityOfPage: { "@id": guideUrl },
          author: { "@type": "Organization", name: "StocksWatch" },
          publisher: { "@type": "Organization", name: "StocksWatch" },
          about: { "@type": "Corporation", name: profile.company, url: profile.website },
          articleSection: "Research methodology",
          inLanguage: "en-US",
        },
        {
          "@type": "BreadcrumbList",
          "@id": `${guideUrl}#breadcrumb`,
          itemListElement: [
            { "@type": "ListItem", position: 1, name: "StocksWatch", item: `${site}/` },
            { "@type": "ListItem", position: 2, name: "NBIS research guide", item: guideUrl },
          ],
        },
      ],
    }
  : undefined;
---

<BaseLayout
  title="How to read the NBIS research desk"
  description={description}
  allowAds={false}
  activeNav="nbis"
  canonicalPath="/guides/nbis-research-guide.html"
  ogType="article"
  articleSection="Research methodology"
  structuredData={structuredData}
>
  <article class="guide-page container">
    <header class="guide-hero">
      <p class="nbis-eyebrow">StocksWatch / Field guide</p>
      <h1>How to read the NBIS research desk</h1>
      <p class="guide-hero__lede">A quick, source-linked way to move from the daily snapshot to the questions that deserve deeper verification.</p>
      <p class="guide-hero__meta">For Nebius Group N.V. · NBIS · Educational research only</p>
      <p class="guide-hero__related"><a href={`${base}guides/nbis-sec-filings.html`}>Need a filing-first workflow? Read the NBIS SEC filings guide →</a></p>
    </header>

    <div class="guide-layout">
      <aside class="guide-index" aria-label="Guide contents">
        <p class="guide-index__label">On this page</p>
        <a href="#freshness">01 / Start with freshness</a>
        <a href="#signals">02 / Read the signal board</a>
        <a href="#business">03 / Separate the business layers</a>
        <a href="#valuation">04 / Treat scenarios as assumptions</a>
        <a href="#sources">05 / Verify the evidence</a>
      </aside>

      <div class="guide-copy">
        <section id="freshness">
          <p class="nbis-eyebrow">01 / Freshness</p>
          <h2>Start with when the snapshot was retrieved</h2>
          <p>The NBIS desk is a daily snapshot, not a streaming quote terminal. Check the status chip and the timestamps before interpreting any number. A stale snapshot can still be useful for context, but it should not be mistaken for current market information.</p>
        </section>

        <section id="signals">
          <p class="nbis-eyebrow">02 / Interpretation</p>
          <h2>Read the signal board as a set of questions</h2>
          <p>The overview cards make the latest price, market capitalization, revenue growth, and free cash flow easy to scan. The interpretation rail adds the important second layer: what the number might mean and what still needs checking.</p>
          <ul>
            <li><strong>Growth:</strong> verify the period, acquisitions, mix, and base effects.</li>
            <li><strong>Cash generation:</strong> read operating cash flow, capital spending, and financing together.</li>
            <li><strong>Balance sheet:</strong> compare cash and debt with commitments, maturities, and share-count changes.</li>
            <li><strong>Trend:</strong> treat moving averages and returns as market context, never as a forecast.</li>
          </ul>
        </section>

        <section id="business">
          <p class="nbis-eyebrow">03 / Business map</p>
          <h2>Separate the core AI cloud from the other layers</h2>
          <p>{profile.company} is building a full-stack AI cloud spanning GPU compute, storage, managed services, and software. The group also includes Avride, TripleTen, and strategic holdings. That mix matters: consolidated results can combine different businesses, accounting treatments, and capital needs.</p>
          <p>Use the business map and monitoring checklist on the main desk to keep the core AI cloud question separate from the performance of the other group businesses.</p>
        </section>

        <section id="valuation">
          <p class="nbis-eyebrow">04 / Assumptions</p>
          <h2>Use valuation scenarios to expose the inputs</h2>
          <p>The scenario table is an assumption framework using growth, exit EV/revenue, cash, debt, and share-count inputs. It is not a price target or a prediction. Change the inputs conceptually, then ask which operating evidence would justify or challenge them.</p>
        </section>

        <section id="sources">
          <p class="nbis-eyebrow">05 / Primary evidence</p>
          <h2>Verify material claims against the source</h2>
          <p>Headlines are discovery aids. For material claims, follow the direct links to company materials and SEC filings. The desk keeps provider names and retrieval times visible so you can understand what each figure represents.</p>
          <div class="guide-sources">
            {profile.sources.map((source) => (
              <a href={source.url} target="_blank" rel="noopener">
                <strong>{source.label} ↗</strong>
                <span>{source.note}</span>
              </a>
            ))}
          </div>
        </section>

        <div class="guide-callout">
          Research and education only — not investment advice. Data can be delayed, incomplete, restated, or wrong. Verify material claims against the latest company filing.
        </div>
        <p class="guide-back"><a href={base}>← Return to the NBIS research desk</a></p>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .guide-page {
    padding-bottom: 5rem;
  }
  .guide-hero {
    max-width: 52rem;
    padding: clamp(4.5rem, 10vw, 8rem) 0 4rem;
  }
  .guide-hero h1 {
    margin: .7rem 0 1.2rem;
    color: var(--text);
    font-size: clamp(2.7rem, 7vw, 5.8rem);
    letter-spacing: -.08em;
    line-height: .95;
  }
  .guide-hero__lede {
    max-width: 42rem;
    margin: 0;
    color: var(--muted);
    font-size: 1.2rem;
    line-height: 1.6;
  }
  .guide-hero__meta {
    margin: 1.4rem 0 0;
    color: var(--dim);
    font: .72rem/1.4 var(--mono);
  }
  .guide-hero__related { margin: 1.2rem 0 0; font-size: .85rem; }
  .guide-hero__related a { color: var(--accent); text-decoration: none; }
  .guide-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 720px);
    gap: clamp(2rem, 7vw, 6rem);
    align-items: start;
  }
  .guide-index {
    position: sticky;
    top: 5.6rem;
    display: grid;
    gap: .6rem;
    padding: 1rem 0;
    border-block: 1px solid var(--border);
  }
  .guide-index__label {
    margin: 0 0 .25rem;
    color: var(--dim);
    font: 600 .68rem/1.2 var(--mono);
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .guide-index a {
    color: var(--muted);
    font-size: .78rem;
    text-decoration: none;
  }
  .guide-index a:hover { color: var(--accent); }
  .guide-copy { min-width: 0; }
  .guide-copy section {
    padding-top: 4rem;
    scroll-margin-top: 5.5rem;
  }
  .guide-copy section:first-child { padding-top: 0; }
  .guide-copy h2 {
    margin: .55rem 0 .9rem;
    color: var(--text);
    font-size: clamp(1.6rem, 3vw, 2.45rem);
    letter-spacing: -.06em;
    line-height: 1.05;
  }
  .guide-copy p, .guide-copy li {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.75;
  }
  .guide-copy ul { display: grid; gap: .7rem; margin: 1.2rem 0 0; padding-left: 1.15rem; }
  .guide-copy strong { color: var(--text); }
  .guide-sources { display: grid; gap: .7rem; margin-top: 1.25rem; }
  .guide-sources a { display: grid; gap: .25rem; padding: .9rem 1rem; border: 1px solid var(--border); border-radius: .75rem; background: var(--surface); text-decoration: none; }
  .guide-sources a:hover { border-color: var(--accent); }
  .guide-sources strong { color: var(--accent); font-size: .85rem; }
  .guide-sources span { color: var(--muted); font-size: .8rem; line-height: 1.5; }
  .guide-callout { margin-top: 4rem; padding: 1rem; border: 1px solid color-mix(in srgb, var(--amber) 35%, var(--border)); border-radius: .75rem; background: color-mix(in srgb, var(--amber) 8%, var(--surface)); color: var(--muted); font-size: .82rem; line-height: 1.6; }
  .guide-back { margin-top: 1.5rem; }
  .guide-back a { color: var(--accent); }
  @media (max-width: 760px) {
    .guide-layout { grid-template-columns: 1fr; gap: 1.5rem; }
    .guide-index { position: static; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .guide-index__label { grid-column: 1 / -1; }
  }
</style>
