---
import { getAdSenseConfig } from "../lib/adsense";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Track stocks you own, price targets you're waiting on, and long-term watchlist picks — one page for the whole group.",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const site = Astro.site ? String(Astro.site).replace(/\/$/, "") : "";
const canonical = site ? `${site}/` : undefined;
const pageTitle = `${title} | StocksWatch`;
const ads = getAdSenseConfig();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#05070a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <title>{pageTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="StocksWatch" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    {
      ads.verifyMeta && (
        <meta name="google-adsense-account" content={ads.verifyMeta} />
      )
    }
    {
      ads.enabled && ads.client && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ads.client}`}
          crossorigin="anonymous"
        />
      )
    }
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="logo" href={base}>
          <span class="logo-mark" aria-hidden="true"></span>
          Stocks Radar
        </a>
        <nav class="header-nav" aria-label="Primary">
          <span class="header-meta mono">group watchlist</span>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>
          Built for friends who talk stocks — not financial advice.
          <a href="https://github.com/Jacob-Idolor/Pet_Projects" target="_blank" rel="noopener">GitHub</a>
        </p>
        <p class="disclaimer">
          Friend suggestions stay pending in the browser until an owner adds them to the master list in git.
          Radar scores are educational guides from technical rules — not financial advice or AI guarantees.
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
