---
import { getAdSenseConfig } from "../lib/adsense";
import SiteHeader from "../components/SiteHeader.astro";
import profile from "../data/nbis-profile.json";

interface Props {
  title: string;
  description?: string;
  /**
   * Load the AdSense script + allow units on this document.
   * Only set true on pages with substantial publisher content.
   * Never true on 404, redirect, or under-construction screens.
   */
  allowAds?: boolean;
  /** Search engines: use noindex on error / empty utility pages */
  noindex?: boolean;
  activeNav?: "datacenter" | "nbis" | "resources";
  /** Override canonical path (default `/`) */
  canonicalPath?: string;
  /** Open Graph type for indexable content pages. */
  ogType?: "website" | "article";
  /** Optional Open Graph article section. */
  articleSection?: string;
  /** Optional schema.org graph for indexable content pages. */
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description = "A source-linked daily research desk for Nebius Group and the AI infrastructure buildout.",
  allowAds = false,
  noindex = false,
  activeNav = "nbis",
  canonicalPath = "/",
  ogType = "website",
  articleSection,
  structuredData,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const site = Astro.site ? String(Astro.site).replace(/\/$/, "") : "";
const path = canonicalPath.startsWith("/") ? canonicalPath : `/${canonicalPath}`;
const canonical = site ? `${site}${path === "/" ? "/" : path}` : undefined;
const pageTitle = `${title} | StocksWatch`;
const jsonLd = structuredData
  ? JSON.stringify(structuredData).replace(/</g, "\\u003c")
  : undefined;
const ads = getAdSenseConfig();
/** Script only when this page opts in AND live ads (or verify meta) are configured. */
const loadAdScript = allowAds && Boolean(ads.client) && ads.enabled;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem("stockswatch-theme");
        if (savedTheme === "light" || savedTheme === "dark") {
          document.documentElement.dataset.theme = savedTheme;
        }
      } catch {}
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#05070a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,nofollow" : "index,follow"} />
    <title>{pageTitle}</title>
    {canonical && !noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && !noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="StocksWatch" />
    {articleSection && <meta property="article:section" content={articleSection} />}
    {structuredData && <script type="application/ld+json" set:html={jsonLd} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    {
      allowAds && ads.verifyMeta && (
        <meta name="google-adsense-account" content={ads.verifyMeta} />
      )
    }
    {
      loadAdScript && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ads.client}`}
          crossorigin="anonymous"
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader active={activeNav} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>
          Built for careful, source-linked research — not financial advice.
          <a href={base}>NBIS Deep Dive</a>
          ·
          <a href={`${base}guides/nbis-research-guide.html`}>Research guide</a>
          ·
          <a href={`${base}research-kit.html`}>Free research kit</a>
          ·
          <a href={`${base}privacy.html`}>Privacy &amp; sponsorship</a>
          ·
          <a href={`https://www.sec.gov/edgar/browse/?CIK=${profile.secCik}&owner=exclude`} target="_blank" rel="noopener">SEC filings</a>
          ·
          <a href="https://github.com/Jacob-Idolor/Pet_Projects" target="_blank" rel="noopener">GitHub</a>
        </p>
        <p class="disclaimer">
          Research and education only. Data can be delayed, incomplete, restated, or wrong. Verify material claims against the latest company filing and do not treat automated scenarios or estimates as guaranteed outcomes.
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
