---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Track stocks you own, price targets you're waiting on, and long-term watchlist picks — one page for the whole group.",
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#05070a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="description" content={description} />
    <title>{title} | Stocks Radar</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="logo" href={base}>
          <span class="logo-mark" aria-hidden="true"></span>
          Stocks Radar
        </a>
        <nav class="header-nav" aria-label="Primary">
          <span class="header-meta mono">group watchlist</span>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>
          Built for friends who talk stocks — not financial advice.
          <a href="https://github.com/Jacob-Idolor/Pet_Projects" target="_blank" rel="noopener">GitHub</a>
        </p>
        <p class="disclaimer">
          New submissions save in your browser until committed to the shared watchlist in git.
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
