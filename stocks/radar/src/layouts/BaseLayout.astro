---
import { getAdSenseConfig } from "../lib/adsense";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
  title: string;
  description?: string;
  /**
   * Load the AdSense script + allow units on this document.
   * Only set true on pages with substantial publisher content (home board).
   * Never true on 404 / alerts / under-construction screens.
   */
  allowAds?: boolean;
  /** Search engines: use noindex on error / empty utility pages */
  noindex?: boolean;
  activeNav?: "watchlist" | "datacenter";
}

const {
  title,
  description = "Track stocks you own, price targets you're waiting on, and long-term watchlist picks — one page for the whole group.",
  allowAds = false,
  noindex = false,
  activeNav = "watchlist",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const site = Astro.site ? String(Astro.site).replace(/\/$/, "") : "";
const canonical = site ? `${site}/` : undefined;
const pageTitle = `${title} | StocksWatch`;
const ads = getAdSenseConfig();
/** Script only when this page opts in AND live ads (or verify meta) are configured. */
const loadAdScript = allowAds && Boolean(ads.client) && (ads.enabled || Boolean(ads.verifyMeta));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#05070a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,nofollow" : "index,follow"} />
    <title>{pageTitle}</title>
    {canonical && !noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && !noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="StocksWatch" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    {
      allowAds && ads.verifyMeta && (
        <meta name="google-adsense-account" content={ads.verifyMeta} />
      )
    }
    {
      loadAdScript && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ads.client}`}
          crossorigin="anonymous"
        />
      )
    }
  </head>
  <body>
    <SiteHeader active={activeNav} />
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>
          Built for friends who talk stocks — not financial advice.
          <a href="https://github.com/Jacob-Idolor/Pet_Projects" target="_blank" rel="noopener">GitHub</a>
        </p>
        <p class="disclaimer">
          Friend suggestions are emailed to the list owner when delivery is configured, and stay pending
          on your device until an owner adds them to the master list in git.
          Radar scores are educational guides from technical rules — not financial advice or AI guarantees.
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
