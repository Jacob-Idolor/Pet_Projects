---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "AI data-center buildout screener — six layers, live quotes, research tools.",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const site = Astro.site ? String(Astro.site).replace(/\/$/, "") : "";
const canonical = site ? `${site}/datacenter.html` : undefined;
const pageTitle = `${title} | StocksWatch`;
const dcBase = `${base}datacenter/`.replace(/\/{2,}/g, "/").replace(":/", "://");
const screenerUrl = `${base}screener.json`.replace(/\/{2,}/g, "/").replace(":/", "://");
---

<!doctype html>
<html
  lang="en"
  data-dc-base={dcBase}
  data-screener-url={screenerUrl}
  data-news-url={`${dcBase}news.json`}
  data-reports-url={`${dcBase}reports.json`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0f14" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <title>{pageTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="stylesheet" href={`${dcBase}style.css`} />
    <style>
      .sw-dc-chrome {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.65rem 1.25rem;
        background: #070a0e;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        font-family: "Segoe UI", system-ui, sans-serif;
      }
      .sw-dc-chrome a {
        color: #9ec5ff;
        text-decoration: none;
        font-size: 0.9rem;
      }
      .sw-dc-chrome a:hover {
        text-decoration: underline;
      }
      .sw-dc-chrome .brand {
        color: #e8eef7;
        font-weight: 650;
        letter-spacing: 0.01em;
      }
      .sw-dc-chrome .brand span {
        color: #7eb6ff;
        font-weight: 500;
      }
      body {
        margin: 0;
      }
    </style>
  </head>
  <body>
    <div class="sw-dc-chrome">
      <a class="brand" href={base}>StocksWatch <span>/ AI Data Center</span></a>
      <nav aria-label="Site">
        <a href={base}>← Group watchlist</a>
      </nav>
    </div>
    <slot />
  </body>
</html>
