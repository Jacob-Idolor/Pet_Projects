---
import SiteHeader from "../components/SiteHeader.astro";
import { getAdSenseConfig } from "../lib/adsense";
import { datacenterAsset } from "../lib/datacenter-assets";

interface Props {
  title: string;
  description?: string;
  allowAds?: boolean;
  /** Absolute path for canonical, e.g. "/" or "/watchlist.html" */
  canonicalPath?: string;
}

const {
  title,
  description = "AI data-center buildout screener — six layers, market snapshots, research tools.",
  allowAds = false,
  canonicalPath = "/",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const site = Astro.site ? String(Astro.site).replace(/\/$/, "") : "";
const path = canonicalPath.startsWith("/") ? canonicalPath : `/${canonicalPath}`;
const canonical = site ? `${site}${path === "/" ? "/" : path}` : undefined;
const pageTitle = `${title} | StocksWatch`;
const dcBase = `${base}datacenter/`.replace(/\/{2,}/g, "/").replace(":/", "://");
const screenerUrl = `${base}screener.json`.replace(/\/{2,}/g, "/").replace(":/", "://");
const styleHref = `${dcBase}${datacenterAsset("style.css")}`;
const ads = getAdSenseConfig();
const loadAdScript = allowAds && Boolean(ads.client) && (ads.enabled || Boolean(ads.verifyMeta));
---

<!doctype html>
<html
  lang="en"
  data-dc-base={dcBase}
  data-screener-url={screenerUrl}
  data-news-url={`${dcBase}news.json`}
  data-reports-url={`${dcBase}reports.json`}
  data-campuses-url={`${dcBase}campuses.json`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#05070a" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <title>{pageTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="StocksWatch" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="stylesheet" href={`${base}tokens.css`.replace(/\/{2,}/g, "/").replace(":/", "://")} />
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin=""
    />
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css"
      crossorigin=""
    />
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css"
      crossorigin=""
    />
    <link rel="stylesheet" href={styleHref} />
    {/* Shared hero / board chrome so Astro markup matches home design language */}
    <style is:global>
      @import "../styles/home/base.css";
      @import "../styles/home/hero-sections.css";
      @import "../styles/home/live-status.css";
      @import "../styles/home/ads.css";

      .dc-page .site-header {
        --header-h: 3.5rem;
      }
      .dc-page .filterbar {
        top: var(--header-h, 3.5rem);
        z-index: 30;
      }
      .dc-page .board-header h2 {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.45rem 0.65rem;
        text-transform: none;
        letter-spacing: -0.02em;
        font-family: var(--font);
        font-size: clamp(1.15rem, 2.5vw, 1.35rem);
        font-weight: 650;
      }
      .dc-page .board-count {
        display: inline-flex;
        align-items: baseline;
        gap: 0.3rem;
        font-family: var(--mono);
        font-size: 0.82rem;
        font-weight: 500;
        letter-spacing: 0;
        color: var(--muted);
      }
      .dc-page .board-count #matchCount {
        color: var(--text);
        font-weight: 600;
      }
      .dc-page .board-actions {
        flex: 1 1 16rem;
        justify-content: flex-end;
        max-width: 28rem;
      }
      .dc-page .search-wrap--dc {
        flex: 1 1 12rem;
        min-width: 0;
      }
      .dc-page .search-wrap--dc .search-input {
        padding-right: 4.5rem;
        font-size: 0.88rem;
        min-height: 2.5rem;
      }
      .dc-page .search-clear {
        position: absolute;
        right: 2.15rem;
        top: 50%;
        transform: translateY(-50%);
        border: none;
        background: transparent;
        color: var(--muted);
        font-size: 0.72rem;
        font-family: var(--mono);
        cursor: pointer;
        padding: 0.2rem 0.35rem;
      }
      .dc-page .search-clear:hover {
        color: var(--text);
      }
      .dc-page .btn-refresh {
        flex: 0 0 auto;
        min-height: 2.5rem;
        padding: 0 0.95rem;
        border-radius: var(--radius-sm);
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--text);
        font-family: var(--font);
        font-size: 0.88rem;
        font-weight: 600;
        cursor: pointer;
        transition: border-color 0.15s ease, background 0.15s ease, opacity 0.15s ease;
      }
      .dc-page .btn-refresh:hover:not(:disabled) {
        border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
        background: var(--surface-hover);
      }
      .dc-page .btn-refresh:disabled,
      .dc-page .btn-refresh.is-busy {
        opacity: 0.65;
        cursor: wait;
      }
      .dc-page .btn-refresh:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
      @media (max-width: 680px) {
        .dc-page .board-actions {
          max-width: none;
          width: 100%;
        }
        .dc-page .search-wrap--dc {
          flex: 1 1 auto;
        }
      }
      .dc-page .mode-purpose {
        margin: 0.35rem 0 0.75rem;
        padding: 0 0.15rem;
        font-size: 0.88rem;
        color: var(--muted);
      }
      .dc-page .mainnav {
        overflow-x: auto;
        scrollbar-width: thin;
        -webkit-overflow-scrolling: touch;
      }
      .dc-page .mainnav button:focus-visible,
      .dc-page .filterbar button:focus-visible,
      .dc-page .search-input:focus-visible,
      .dc-page .btn-refresh:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
      .dc-page .empty-state,
      .dc-page .error-state {
        margin: 1.5rem 0;
        padding: 1.25rem 1.35rem;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--panel);
        text-align: left;
        max-width: 36rem;
      }
      .dc-page .empty-state h3,
      .dc-page .error-state h3 {
        margin: 0 0 0.35rem;
        font-size: 1.05rem;
      }
      .dc-page .empty-state p,
      .dc-page .error-state p {
        margin: 0 0 0.85rem;
        color: var(--muted);
        font-size: 0.92rem;
      }
      .dc-page .desktop-only {
        display: block;
      }
      @media (max-width: 680px) {
        .dc-page .desktop-only {
          display: none !important;
        }
        .dc-page .filterbar .cap-filter,
        .dc-page .filterbar .cols-label,
        .dc-page .filterbar #colset,
        .dc-page .filterbar #scoreMode,
        .dc-page .filterbar #scoreInfo {
          display: none;
        }
        .dc-page .hero {
          padding-block: 1rem 0.35rem;
        }
        .dc-page .board-header {
          flex-direction: column;
          align-items: stretch;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .dc-page .live-status__dot,
        .dc-page .tt-dot {
          animation: none !important;
        }
      }
    </style>
    {
      allowAds && ads.verifyMeta && (
        <meta name="google-adsense-account" content={ads.verifyMeta} />
      )
    }
    {
      loadAdScript && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ads.client}`}
          crossorigin="anonymous"
        />
      )
    }
    <script
      is:inline
      src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
      integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
      crossorigin=""></script>
    <script
      is:inline
      src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"
      crossorigin=""></script>
  </head>
  <body class="dc-page">
    <SiteHeader active="datacenter" />
    <slot />
  </body>
</html>
