---
import SiteHeader from "../components/SiteHeader.astro";
import { getAdSenseConfig } from "../lib/adsense";
import { datacenterAsset } from "../lib/datacenter-assets";

interface Props {
  title: string;
  description?: string;
  allowAds?: boolean;
  /** Absolute path for canonical, e.g. "/" or "/watchlist.html" */
  canonicalPath?: string;
}

const {
  title,
  description = "AI data-center buildout screener — six layers, market snapshots, research tools.",
  allowAds = false,
  canonicalPath = "/",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const site = Astro.site ? String(Astro.site).replace(/\/$/, "") : "";
const path = canonicalPath.startsWith("/") ? canonicalPath : `/${canonicalPath}`;
const canonical = site ? `${site}${path === "/" ? "/" : path}` : undefined;
const pageTitle = `${title} | StocksWatch`;
const dcBase = `${base}datacenter/`.replace(/\/{2,}/g, "/").replace(":/", "://");
const screenerUrl = `${base}screener.json`.replace(/\/{2,}/g, "/").replace(":/", "://");
const styleHref = `${dcBase}${datacenterAsset("style.css")}`;
const ads = getAdSenseConfig();
const loadAdScript = allowAds && Boolean(ads.client) && (ads.enabled || Boolean(ads.verifyMeta));
---

<!doctype html>
<html
  lang="en"
  data-dc-base={dcBase}
  data-screener-url={screenerUrl}
  data-news-url={`${dcBase}news.json`}
  data-reports-url={`${dcBase}reports.json`}
  data-campuses-url={`${dcBase}campuses.json`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#05070a" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <title>{pageTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="StocksWatch" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="stylesheet" href={`${base}tokens.css`.replace(/\/{2,}/g, "/").replace(":/", "://")} />
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin=""
    />
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css"
      crossorigin=""
    />
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css"
      crossorigin=""
    />
    <link rel="stylesheet" href={styleHref} />
    {
      allowAds && ads.verifyMeta && (
        <meta name="google-adsense-account" content={ads.verifyMeta} />
      )
    }
    {
      loadAdScript && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ads.client}`}
          crossorigin="anonymous"
        />
      )
    }
    <script
      is:inline
      src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
      integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
      crossorigin=""></script>
    <script
      is:inline
      src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"
      crossorigin=""></script>
  </head>
  <body class="dc-page">
    <SiteHeader active="datacenter" />
    <slot />
  </body>
</html>
