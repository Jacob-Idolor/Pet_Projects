---
import SiteHeader from "../components/SiteHeader.astro";
import { datacenterAsset } from "../lib/datacenter-assets";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "AI data-center buildout screener — six layers, market snapshots, research tools.",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const site = Astro.site ? String(Astro.site).replace(/\/$/, "") : "";
const canonical = site ? `${site}/datacenter.html` : undefined;
const pageTitle = `${title} | StocksWatch`;
const dcBase = `${base}datacenter/`.replace(/\/{2,}/g, "/").replace(":/", "://");
const screenerUrl = `${base}screener.json`.replace(/\/{2,}/g, "/").replace(":/", "://");
const styleHref = `${dcBase}${datacenterAsset("style.css")}`;
---

<!doctype html>
<html
  lang="en"
  data-dc-base={dcBase}
  data-screener-url={screenerUrl}
  data-news-url={`${dcBase}news.json`}
  data-reports-url={`${dcBase}reports.json`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#05070a" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <title>{pageTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="StocksWatch" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="stylesheet" href={`${base}tokens.css`.replace(/\/{2,}/g, "/").replace(":/", "://")} />
    <link rel="stylesheet" href={styleHref} />
  </head>
  <body class="dc-page">
    <SiteHeader active="datacenter" />
    <slot />
  </body>
</html>
