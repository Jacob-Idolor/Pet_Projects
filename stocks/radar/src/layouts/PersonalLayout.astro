---
import '../styles/personal.css';
interface Props {
  title: string;
  description: string;
  active?: string;
  noindex?: boolean;
  article?: { publishedAt: string; modifiedAt: string };
}
const { title, description, active, noindex = false, article } = Astro.props;
// Pages redirects file-format HTML URLs to these extensionless reader routes.
const canonicalPath = Astro.url.pathname === '/index.html' ? '/' : Astro.url.pathname.replace(/\.html$/, '');
const canonical = new URL(canonicalPath, Astro.site);
const authorUrl = new URL('/about', Astro.site);
const navigation = [['Connect', '/about#profiles'], ['Guides', '/guides'], ['Resources', '/resources'], ['About', '/about'], ['Consulting', '/consulting']];
const articleData = article && !noindex ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: article.publishedAt,
  dateModified: article.modifiedAt,
  author: { '@type': 'Person', name: 'Jacob', url: authorUrl.href },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical.href },
  url: canonical.href,
  inLanguage: 'en',
} : undefined;
const articleJson = articleData && JSON.stringify(articleData).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} · J Sol</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={`${title} · J Sol`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={articleData ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="J Sol" />
    {articleData && <>
      <meta property="article:published_time" content={articleData.datePublished} />
      <meta property="article:modified_time" content={articleData.dateModified} />
      <meta property="article:author" content={authorUrl} />
      <script type="application/ld+json" set:html={articleJson} />
    </>}
    <meta name="theme-color" content="#f7f7fb" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="header wrap">
      <a class="brand" href="/" aria-label="J Sol home"><span aria-hidden="true">j<span class="brand-dot">.</span></span> J Sol</a>
      <nav aria-label="Primary">{navigation.map(([label, href]) => <a href={href} class:list={{ 'nav-connect': label === 'Connect' }} aria-current={active === label ? 'page' : undefined}>{label}</a>)}</nav>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="footer wrap"><div><a class="footer-name" href="/">J Sol</a><p>Useful systems. A little more room for life.</p></div><div><a href="/about">About this project</a><a href="/privacy">Privacy</a><span>Built small. Kept simple.</span></div></footer>
  </body>
</html>
