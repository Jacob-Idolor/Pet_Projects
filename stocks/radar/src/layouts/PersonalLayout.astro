---
import '../styles/personal.css';
import '../styles/creator.css';
interface Props {
  title: string;
  description: string;
  active?: string;
  noindex?: boolean;
  article?: { publishedAt: string; modifiedAt: string };
}
const { title, description, active, noindex = false, article } = Astro.props;
// Pages redirects file-format HTML URLs to these extensionless reader routes.
const canonicalPath = Astro.url.pathname === '/index.html' ? '/' : Astro.url.pathname.replace(/\.html$/, '');
const canonical = new URL(canonicalPath, Astro.site);
const authorUrl = new URL('/about', Astro.site);
const navigation = [['Stories', '/#stories'], ['Watch', '/links#watch'], ['Links', '/links'], ['About', '/about']];
const articleData = article && !noindex ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: article.publishedAt,
  dateModified: article.modifiedAt,
  author: { '@type': 'Person', name: 'Jacob', url: authorUrl.href },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical.href },
  url: canonical.href,
  inLanguage: 'en',
} : undefined;
const articleJson = articleData && JSON.stringify(articleData).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} · J Sol</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={`${title} · J Sol`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={articleData ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="J Sol" />
    {articleData && <>
      <meta property="article:published_time" content={articleData.datePublished} />
      <meta property="article:modified_time" content={articleData.dateModified} />
      <meta property="article:author" content={authorUrl} />
      <script type="application/ld+json" set:html={articleJson} />
    </>}
    <meta name="theme-color" content="#f5f2e9" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="header wrap">
      <a class="brand" href="/" aria-label="J Sol / Jacob home">j. / Jacob</a>
      <nav class="desktop-navigation" aria-label="Primary">{navigation.map(([label, href]) => <a href={href} aria-current={active === label ? 'page' : undefined}>{label}</a>)}</nav>
      <button class="menu-toggle" popovertarget="mobile-menu">Menu <span aria-hidden="true">☰</span></button>
      <nav id="mobile-menu" class="mobile-navigation" popover="auto" aria-label="Mobile navigation">
        <div class="menu-heading"><strong>Find your way</strong><button popovertarget="mobile-menu" popovertargetaction="hide" aria-label="Close menu">Close ×</button></div>
        {navigation.map(([label, href]) => <a href={label === 'Stories' ? '/' : label === 'Watch' ? '/links' : href} aria-current={active === label ? 'page' : undefined}>{label}</a>)}
        <a href="/guides">Practical guides</a><a href="/resources">Toolkit</a><a href="/consulting">Consulting</a><a href="/about">All public profiles</a>
      </nav>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="footer"><div class="wrap"><a class="footer-name" href="/">J Sol / Jacob</a><p>A home for the things I’m learning and making.</p><div class="footer-links"><a href="/links">All links</a><a href="/guides">Practical guides</a><a href="/resources">Toolkit</a><a href="/consulting">Consulting</a><a href="/about#profiles">Connect</a><a href="/privacy">Privacy</a></div><p class="footer-domain">stockswatch.cc / Independent creator</p></div></footer>
  </body>
</html>
