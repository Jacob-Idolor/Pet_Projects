---
// Public URLs supplied and verified by the owner. Add another profile only after
// its public identity and destination have been confirmed.
const profiles = [
  { name: 'Upwork', url: 'https://www.upwork.com/freelancers/~01970b1d2f8e96b33f' },
  { name: 'Guru', url: 'https://www.guru.com/freelancers/jacob-idolor' },
];
---
<section id="profiles" aria-labelledby="profiles-title">
  <h2 id="profiles-title">Profiles and services</h2>
  <p>Explore my <a href="/consulting">Monitoring &amp; Alert Health Check</a> for the service scope and deliverables. You can also find me on these freelance platforms.</p>
  <ul class="profile-links">
    {profiles.map(profile => (
      <li>
        <a href={profile.url} target="_blank" rel="noopener noreferrer">
          <span>{profile.name}</span>
          <span class="profile-action">View my public profile <span aria-hidden="true">↗</span></span>
        </a>
      </li>
    ))}
  </ul>
  <p class="small">Profiles open in a new tab. Discuss scope and availability on your preferred platform before starting a project.</p>
</section>
<style>
  ul.profile-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; list-style: none; padding: 0; margin: 24px 0 18px; }
  .profile-links li { margin: 0; }
  .profile-links a { display: flex; flex-direction: column; gap: 10px; border: 1px solid var(--line); border-radius: 5px; padding: 20px; background: #faf9f5; text-decoration: none; }
  .profile-links a:hover { border-color: var(--blue); }
  .profile-links a > span:first-child { font-weight: 700; }
  .profile-action { color: var(--muted); font-size: .85rem; }
  @media (max-width: 480px) { ul.profile-links { grid-template-columns: 1fr; } }
</style>
