---
import SocialChannels from './SocialChannels.astro';
import { linkedIn, consultingProfiles } from '../data/profiles';
---
<section id="profiles" aria-labelledby="profiles-title" tabindex="-1">
  <h2 id="profiles-title">Connect with Jacob</h2>
  <p>My channels and social profiles, all in one place. Public links open in a new tab.</p>
  <SocialChannels />
  <p class="professional-link"><a href={linkedIn.url} target="_blank" rel="noopener noreferrer">Find me on LinkedIn <span aria-hidden="true">&nearr;</span></a></p>
  <details class="consulting-profiles">
    <summary>Consulting &amp; freelance profiles</summary>
    <p>Explore my <a href="/consulting">Monitoring &amp; Alert Health Check</a> for the service scope and deliverables.</p>
    <ul class="profile-links">
      {consultingProfiles.map(profile => (
        <li><a href={profile.url} target="_blank" rel="noopener noreferrer">{profile.name} <span aria-hidden="true">&nearr;</span></a></li>
      ))}
    </ul>
    <p class="small">Discuss scope and availability on your preferred platform before starting a project.</p>
  </details>
</section>
<style>
  #profiles { scroll-margin-top: 24px; margin-block: 36px 48px; }
  .professional-link { margin-block: 22px; font-size: .9rem; }
  .consulting-profiles { padding: 18px 0; border-block: 1px solid var(--line); }
  summary { cursor: pointer; padding-block: 4px; font-size: .95rem; }
  .consulting-profiles p { margin-top: 20px; }
  ul.profile-links { display: flex; flex-wrap: wrap; gap: 14px 28px; list-style: none; padding: 0; margin-block: 18px; }
  .profile-links li { margin: 0; }
  .profile-links a { display: inline-block; padding-block: 8px; }
  .consulting-profiles p:last-child { margin-bottom: 0; }
</style>
