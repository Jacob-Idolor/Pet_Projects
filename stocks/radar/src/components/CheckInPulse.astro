---
---

<section class="checkin-pulse" id="checkin" aria-labelledby="checkin-title">
  <div class="checkin-header">
    <div>
      <p class="board-eyebrow">Friend check-in</p>
      <h2 id="checkin-title">Today’s pulse</h2>
      <p class="checkin-lede">
        Stock outlook starts with <strong>valuation + news</strong> (expand any ticker).
        Macro mood is <a href="#macro-rates">rates / bonds / yields</a> above.
        This pulse is secondary — weighted technical momentum that may or may not hold.
      </p>
    </div>
    <nav class="checkin-jump desktop-only" aria-label="Jump to sections">
      <a href="#macro-rates">Rates</a>
      <a href="#checkin" class="is-active">Pulse</a>
      <a href="#dc-bridge">AI DC</a>
      <a href="#watchlist-board">Master list</a>
      <a href="#submissions">Suggest</a>
    </nav>
  </div>

  <div class="checkin-guide" aria-label="How to read the board">
    <article class="checkin-guide__card checkin-guide__card--buy">
      <h3>1 · Valuation + news</h3>
      <p>Expand a name for PE / forward PE, group valuation lean, and headlines tagged positive/negative — that news check feeds the lean score.</p>
    </article>
    <article class="checkin-guide__card checkin-guide__card--sma">
      <h3>2 · Rates tape</h3>
      <p>10Y / front-end / long bonds / dollar above — gravity for multiples. Macro first, then tickers.</p>
    </article>
    <article class="checkin-guide__card checkin-guide__card--watch">
      <h3>3 · Momentum (pulse)</h3>
      <p>Weighted RSI / 52w / SMA50 / pre-momentum coils. Useful for timing talk — not the thesis.</p>
    </article>
    <article class="checkin-guide__card checkin-guide__card--sell">
      <h3>Thresholds</h3>
      <p>Lean buy ≥ +3 · Watch −2…+2 · Lean sell ≤ −3. Same checklist on every ticker — chat bait, not advice.</p>
    </article>
  </div>

  <div class="checkin-tally" id="checkin-tally" aria-live="polite">
    <span class="checkin-tally__loading">Scoring the master list…</span>
  </div>

  <div class="checkin-tabs" role="tablist" aria-label="Pulse views">
    <button type="button" class="checkin-tab is-active" role="tab" aria-selected="true" data-checkin-tab="gainers" id="tab-gainers">Gainers</button>
    <button type="button" class="checkin-tab" role="tab" aria-selected="false" data-checkin-tab="losers" id="tab-losers">Losers</button>
    <button type="button" class="checkin-tab" role="tab" aria-selected="false" data-checkin-tab="setups" id="tab-setups">Lean buy</button>
    <button type="button" class="checkin-tab" role="tab" aria-selected="false" data-checkin-tab="watch" id="tab-watch">Watch</button>
    <button type="button" class="checkin-tab" role="tab" aria-selected="false" data-checkin-tab="caution" id="tab-caution">Lean sell</button>
  </div>

  <div class="checkin-grid" data-active-panel="gainers">
    <article class="checkin-panel checkin-panel--up is-active" data-checkin-panel="gainers" aria-labelledby="gainers-title">
      <header class="checkin-panel__head">
        <h3 id="gainers-title">Gainers</h3>
      </header>
      <ol class="checkin-rank" id="checkin-gainers" aria-live="polite">
        <li class="checkin-rank__empty">Loading quotes…</li>
      </ol>
    </article>

    <article class="checkin-panel checkin-panel--down" data-checkin-panel="losers" aria-labelledby="losers-title">
      <header class="checkin-panel__head">
        <h3 id="losers-title">Losers</h3>
      </header>
      <ol class="checkin-rank" id="checkin-losers" aria-live="polite">
        <li class="checkin-rank__empty">Loading quotes…</li>
      </ol>
    </article>

    <article class="checkin-panel checkin-panel--buy" data-checkin-panel="setups" aria-labelledby="setups-title">
      <header class="checkin-panel__head">
        <h3 id="setups-title">Lean buy</h3>
      </header>
      <ol class="checkin-rank" id="checkin-setups" aria-live="polite">
        <li class="checkin-rank__empty">Scoring master list…</li>
      </ol>
    </article>

    <article class="checkin-panel checkin-panel--watch" data-checkin-panel="watch" aria-labelledby="watch-title">
      <header class="checkin-panel__head">
        <h3 id="watch-title">Watch / pre-momentum</h3>
        <p>Mixed scores — quiet coils float to the top</p>
      </header>
      <ol class="checkin-rank" id="checkin-watch" aria-live="polite">
        <li class="checkin-rank__empty">Scoring master list…</li>
      </ol>
    </article>

    <article class="checkin-panel checkin-panel--sell" data-checkin-panel="caution" aria-labelledby="caution-title">
      <header class="checkin-panel__head">
        <h3 id="caution-title">Lean sell</h3>
      </header>
      <ol class="checkin-rank" id="checkin-caution" aria-live="polite">
        <li class="checkin-rank__empty">Scoring master list…</li>
      </ol>
    </article>
  </div>
</section>

<nav class="mobile-dock" aria-label="Primary">
  <a href="#macro-rates" class="mobile-dock__link" data-dock="rates">
    <span class="mobile-dock__label">Rates</span>
  </a>
  <a href="#checkin" class="mobile-dock__link is-active" data-dock="checkin">
    <span class="mobile-dock__label">Pulse</span>
  </a>
  <a href="#dc-bridge" class="mobile-dock__link" data-dock="aidc">
    <span class="mobile-dock__label">AI DC</span>
  </a>
  <a href="#watchlist-board" class="mobile-dock__link" data-dock="list">
    <span class="mobile-dock__label">List</span>
  </a>
  <a href="#submissions" class="mobile-dock__link" data-dock="suggest">
    <span class="mobile-dock__label">Suggest</span>
  </a>
</nav>

<script is:inline>
  (function () {
    var root = document.getElementById("checkin");
    if (!root) return;
    var tabs = root.querySelectorAll("[data-checkin-tab]");
    var grid = root.querySelector(".checkin-grid");

    function activate(name) {
      if (grid) grid.setAttribute("data-active-panel", name);
      tabs.forEach(function (tab) {
        var on = tab.getAttribute("data-checkin-tab") === name;
        tab.classList.toggle("is-active", on);
        tab.setAttribute("aria-selected", on ? "true" : "false");
      });
      root.querySelectorAll("[data-checkin-panel]").forEach(function (panel) {
        panel.classList.toggle("is-active", panel.getAttribute("data-checkin-panel") === name);
      });
    }

    tabs.forEach(function (tab) {
      tab.addEventListener("click", function () {
        activate(tab.getAttribute("data-checkin-tab") || "gainers");
      });
    });

    var docks = document.querySelectorAll(".mobile-dock__link");
    function syncDock() {
      var y = window.scrollY + 120;
      var sections = [
        { id: "macro-rates", key: "rates" },
        { id: "checkin", key: "checkin" },
        { id: "dc-bridge", key: "aidc" },
        { id: "watchlist-board", key: "list" },
        { id: "submissions", key: "suggest" },
      ];
      var active = "rates";
      for (var i = 0; i < sections.length; i++) {
        var el = document.getElementById(sections[i].id);
        if (el && el.offsetTop <= y) active = sections[i].key;
      }
      docks.forEach(function (a) {
        a.classList.toggle("is-active", a.getAttribute("data-dock") === active);
      });
    }

    window.addEventListener("scroll", syncDock, { passive: true });
    docks.forEach(function (a) {
      a.addEventListener("click", function () {
        setTimeout(syncDock, 80);
      });
    });
    syncDock();
  })();
</script>
