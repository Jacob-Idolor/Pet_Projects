---
/**
 * Editorial publisher content for AdSense quality / policy.
 * Placed after the watchlist so ads never sit on a chrome-only screen.
 */
import { meta, stocks } from "../data/watchlist";

const sectors = [
  ...new Set(stocks.map((s) => s.sector).filter(Boolean) as string[]),
].slice(0, 8);
---

<section class="publisher-content" id="about" aria-labelledby="about-heading">
  <p class="board-eyebrow">About this page</p>
  <h2 id="about-heading">What StocksWatch publishes</h2>
  <div class="publisher-content__body">
    <p>
      StocksWatch is a shared research board for a small investing group. The master list
      tracks <strong>{stocks.length} tickers</strong>
      {
        sectors.length > 0 && (
          <>
            {" "}
            across themes like {sectors.map((s, i) => (
              <>
                {i > 0 && (i === sectors.length - 1 ? " and " : ", ")}
                <em>{s}</em>
              </>
            ))}
          </>
        )
      }
      . Each name includes a short thesis, optional valuation notes, and tags so the group
      can discuss setups without treating the page as a trading signal.
    </p>
    <p>
      {meta.tagline} Macro rates, recent headlines, and a weighted technical lean are shown
      as <strong>discussion aids</strong> — not personalized investment advice. Scores follow
      transparent rules documented in the project’s SCORE notes.
    </p>
    <p>
      The companion <a href={import.meta.env.BASE_URL}>AI Data Center</a>{" "}
      screener (homepage) organizes the AI infrastructure buildout into six layers
      (land, power, cooling, compute, networking, software) with snapshot market data.
      This archived watchlist stays available for the group check-in board.
    </p>
    <p class="publisher-content__disclaimer">
      Nothing on this site is a recommendation to buy or sell any security. Do your own
      research. Past performance does not indicate future results.
    </p>
  </div>
</section>
