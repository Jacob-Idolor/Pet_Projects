---
const base = import.meta.env.BASE_URL;
---

<section class="macro-strip" id="macro-rates" aria-labelledby="macro-title" data-radar-base={base}>
  <div class="macro-strip__head">
    <div>
      <p class="board-eyebrow">Macro tape</p>
      <h2 id="macro-title">Rates · bonds · dollar</h2>
      <p class="macro-strip__lede">
        For the market’s mood, this matters more than any single ticker’s chart.
        Yields up → equity valuations usually compress. Watch the curve, then the names.
      </p>
    </div>
  </div>
  <div class="macro-strip__grid" id="macro-grid" aria-live="polite">
    <p class="macro-strip__loading">Loading yields…</p>
  </div>
</section>

<script is:inline define:vars={{ base }}>
  (function () {
    var grid = document.getElementById("macro-grid");
    if (!grid) return;
    var root = base || "/";
    if (root.slice(-1) !== "/") root += "/";

    function escapeHtml(s) {
      return String(s == null ? "" : s)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function fmtPx(v, unit) {
      if (v == null || isNaN(v)) return "—";
      if (unit === "yield") return Number(v).toFixed(3) + "%";
      return Number(v).toLocaleString(undefined, { maximumFractionDigits: 2 });
    }

    function fmtChg(v) {
      var n = Number(v);
      if (v == null || v === "" || !Number.isFinite(n)) return "";
      var sign = n > 0 ? "+" : "";
      return sign + n.toFixed(2) + "%";
    }

    fetch(root + "outlook.json?t=" + Date.now(), { cache: "no-store" })
      .then(function (r) {
        if (!r.ok) throw new Error("HTTP " + r.status);
        return r.json();
      })
      .then(function (data) {
        var macro = data.macro || {};
        var keys = Object.keys(macro);
        if (!keys.length) {
          grid.innerHTML =
            '<p class="macro-strip__loading">Macro series unavailable — retry quote refresh.</p>';
          return;
        }
        grid.innerHTML = keys
          .map(function (id) {
            var m = macro[id] || {};
            var chg = m.changePct;
            var cls = chg == null ? "" : chg >= 0 ? "up" : "down";
            var label = escapeHtml(m.label || id);
            var blurb = escapeHtml(m.blurb || "");
            return (
              '<article class="macro-card" title="' +
              blurb +
              '">' +
              '<span class="macro-card__label">' +
              label +
              "</span>" +
              '<span class="macro-card__px mono">' +
              escapeHtml(fmtPx(m.price, m.unit)) +
              "</span>" +
              '<span class="macro-card__chg mono ' +
              cls +
              '">' +
              escapeHtml(fmtChg(chg)) +
              "</span>" +
              '<span class="macro-card__blurb">' +
              blurb +
              "</span>" +
              "</article>"
            );
          })
          .join("");
      })
      .catch(function () {
        grid.innerHTML =
          '<p class="macro-strip__loading">Could not load outlook.json yet — run quote refresh.</p>';
      });
  })();
</script>
