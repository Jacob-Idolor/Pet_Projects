---
import buildMeta from "../../public/build-meta.json";

const buildTime = new Date(buildMeta.builtAt);
const buildLabel = buildTime.toLocaleString(undefined, {
  dateStyle: "medium",
  timeStyle: "short",
});
const shortSha = buildMeta.gitSha.slice(0, 7);
const deployLabel =
  buildMeta.deployProvider === "github-actions"
    ? "GitHub Actions → AWS"
    : buildMeta.deployProvider;
const base = import.meta.env.BASE_URL;
const quotesUrl = `${base}quotes.json`.replace(/\/{2,}/g, "/").replace(":/", "://");
---

<div class="live-status" id="live-status" data-quotes-url={quotesUrl}>
  <span class="live-status__dot" aria-hidden="true"></span>
  <span id="live-status-text">
    Deployed {buildLabel} · {deployLabel} · <code>{shortSha}</code>
  </span>
</div>

<script define:vars={{ buildMeta, quotesUrl }}>
  const statusEl = document.getElementById("live-status-text");
  const dot = document.querySelector(".live-status__dot");

  async function refreshStatus() {
    try {
      const res = await fetch(`${quotesUrl}?t=${Date.now()}`, { cache: "no-store" });
      if (!res.ok) throw new Error("quotes fetch failed");
      const data = await res.json();
      const fetchedAt = new Date(data.fetchedAt);
      const ageMin = Math.round((Date.now() - fetchedAt.getTime()) / 60000);
      const ageLabel =
        ageMin < 1 ? "just now" : ageMin === 1 ? "1 min ago" : `${ageMin} min ago`;
      const shortSha = buildMeta.gitSha.slice(0, 7);
      const deployLabel =
        buildMeta.deployProvider === "github-actions"
          ? "GitHub Actions → AWS"
          : buildMeta.deployProvider;
      if (statusEl) {
        statusEl.innerHTML = `Quotes ${ageLabel} · Deploy ${new Date(buildMeta.builtAt).toLocaleString(undefined, { dateStyle: "medium", timeStyle: "short" })} · ${deployLabel} · <code>${shortSha}</code>`;
      }
      dot?.classList.add("live");
    } catch {
      /* keep build-time label */
    }
  }

  refreshStatus();
  setInterval(refreshStatus, 60_000);
</script>
