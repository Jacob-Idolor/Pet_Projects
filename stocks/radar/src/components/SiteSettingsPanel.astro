---
import { getSiteSettings } from "../lib/site-config";

const settings = getSiteSettings();
const features = Object.entries(settings.features).filter(([, on]) => on);
---

<section class="site-settings-panel" id="settings" aria-labelledby="settings-title">
  <details class="settings-details">
    <summary class="settings-summary">
      <span>
        <p class="board-eyebrow">Configuration</p>
        <h2 id="settings-title">Settings</h2>
      </span>
      <span class="settings-meta mono">{settings.app.name} v{settings.app.version}</span>
    </summary>

    <div class="settings-body">
      <p class="subtitle">
        Product defaults live in <code>site-settings.json</code> (deployed with the site).
        Viewer prefs (sort, page size, view) stay in your browser. Ops secrets stay in
        Terraform / GitHub — never in this file.
      </p>

      <div class="settings-grid">
        <article class="settings-card">
          <h3>Quotes</h3>
          <dl>
            <div><dt>Stale after</dt><dd class="mono">{settings.quotes.staleAfterHours}h</dd></div>
            <div><dt>Poll interval</dt><dd class="mono">{Math.round(settings.quotes.pollIntervalMs / 1000)}s</dd></div>
            <div><dt>Browser fallback</dt><dd>{settings.quotes.browserFallback ? "On" : "Off"}</dd></div>
          </dl>
        </article>

        <article class="settings-card">
          <h3>Board defaults</h3>
          <dl>
            <div><dt>Page size</dt><dd class="mono">{settings.board.defaultPageSize}</dd></div>
            <div><dt>Sort</dt><dd class="mono">{settings.board.defaultSort}</dd></div>
            <div><dt>View</dt><dd class="mono">{settings.board.defaultView}</dd></div>
          </dl>
        </article>

        <article class="settings-card">
          <h3>Alerts</h3>
          <dl>
            <div><dt>Cooldown</dt><dd class="mono">{settings.alerts.defaultCooldownHours}h</dd></div>
            <div><dt>Near target</dt><dd class="mono">±{settings.alerts.nearTargetPct}%</dd></div>
            <div><dt>Min buy score</dt><dd class="mono">{settings.alerts.minBuyScore}</dd></div>
          </dl>
        </article>

        <article class="settings-card">
          <h3>Features</h3>
          <ul class="settings-feature-list">
            {
              features.map(([name]) => (
                <li>
                  <span class="mono">{name}</span>
                  <span class="settings-on">on</span>
                </li>
              ))
            }
          </ul>
        </article>
      </div>

      <p class="settings-links">
        <a href="/settings.json">settings.json</a>
        ·
        <a href="/health.json">health.json</a>
        ·
        <a href="https://github.com/Jacob-Idolor/Pet_Projects/blob/main/stocks/radar/PRODUCTION.md">Production checklist</a>
      </p>
    </div>
  </details>
</section>
