---
import { recentVideos } from '../data/videos.mjs';
---
{recentVideos.length > 0 && <section class="recent-videos wrap" id="recent-videos" tabindex="-1" aria-labelledby="recent-videos-title"><p class="eyebrow">From the video shelf</p><h2 id="recent-videos-title">Recent videos</h2><p class="section-intro">A few published reflections, reviews and gameplay clips.</p><div class="video-grid">{recentVideos.map(video => <article class="video-card" data-topic={video.topic}><a href={video.publications[0].url} target="_blank" rel="noopener noreferrer"><span class="video-topic">{video.topic}</span><h3>{video.title}</h3><p>{video.description}</p><span class="video-action">Watch on {video.publications[0].platform} <span aria-hidden="true">↗</span></span><span class="sr-only"> (opens in a new tab)</span></a></article>)}</div></section>}
<style>
  .recent-videos { padding-block: 40px 56px; scroll-margin-top: 24px; }
  .video-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 24px; }
  .video-card { min-width: 0; border: 1px solid var(--line); border-radius: 18px; background: #fff; }
  .video-card > a { display: flex; flex-direction: column; height: 100%; padding: 28px; color: var(--ink); text-decoration: none; }
  .video-card > a:hover { border-radius: 18px; box-shadow: 0 8px 24px #173d3214; }
  .video-card h3 { font-size: 28px; line-height: 1.16; }
  .video-card p { color: var(--muted); font-size: 16px; }
  .video-topic { align-self: flex-start; padding: 7px 12px; margin-bottom: 24px; border-radius: 999px; background: var(--sage); font-size: 12px; font-weight: 700; }
  [data-topic="Discoveries"] .video-topic { background: var(--peach); }
  [data-topic="Gaming"] .video-topic { background: var(--yellow); }
  .video-action { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; margin-top: auto; font-size: 14px; font-weight: 700; }
  @media (max-width: 900px) { .video-grid { grid-template-columns: 1fr; } }
</style>
