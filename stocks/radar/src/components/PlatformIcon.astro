---
interface Props { kind: string; }
const { kind } = Astro.props;
---
<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {kind === 'twitch' && <><path d="M5 3h16v12l-5 5h-5l-4 3v-3H3V7l2-4Z" /><path d="M9 8v5m6-5v5" /></>}
  {kind === 'youtube' && <><rect x="2" y="5" width="20" height="14" rx="4" /><path d="m10 9 5 3-5 3Z" fill="currentColor" stroke="none" /></>}
  {kind === 'instagram' && <><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none" /></>}
  {kind === 'snapchat' && <><path d="M8 14V8a4 4 0 0 1 8 0v6c.7 1.2 1.8 1.8 3 2-1 .7-1.8.9-2 2-.8-.4-1.4-.3-2 .1-1.8 1.8-4.2 1.8-6 0-.6-.4-1.2-.5-2-.1-.2-1.1-1-1.3-2-2 1.2-.2 2.3-.8 3-2Z" /><path d="m6 11 2 1m10-1-2 1" /><circle cx="10.5" cy="9" r=".6" fill="currentColor" stroke="none" /><circle cx="13.5" cy="9" r=".6" fill="currentColor" stroke="none" /></>}
  {kind === 'linkedin' && <><rect x="3" y="3" width="18" height="18" rx="4" /><path d="M8 10v7m4 0v-7m0 3a3 3 0 0 1 6 0v4" /><circle cx="8" cy="7" r=".8" fill="currentColor" stroke="none" /></>}
  {kind === 'tiktok' && <><path d="M14 3v12.5a3.5 3.5 0 1 1-3.5-3.5H12M14 3c.8 3.1 2.7 5 6 5v4a8.8 8.8 0 0 1-6-2" /></>}
  {kind === 'threads' && <path d="M18 7c-1-2.7-3-4-6-4-4.4 0-6.5 3-6.5 9s2.3 9 6.8 9c3.6 0 5.9-1.8 5.9-4.6 0-2.6-2-4.2-5.4-4.2-2.6 0-4 1-4 2.6 0 1.4 1.1 2.4 2.8 2.4 2.2 0 3.6-1.8 3.6-4.9 0-3-1.3-4.7-3.6-4.7-1.4 0-2.5.5-3.2 1.5" />}
  {kind === 'goodreads' && <><path d="M12 5c-3-2-6-2-9-1v15c3-1 6-1 9 1 3-2 6-2 9-1V4c-3-1-6-1-9 1Zm0 0v15" /></>}
  {kind === 'substack' && <><path d="M4 3h16M4 7h16M4 11h16v10l-8-4-8 4Z" /></>}
  {kind === 'arrow' && <path d="M6 18 18 6M6 6h12v12" />}
  {kind === 'briefcase' && <><rect x="3" y="7" width="18" height="14" rx="3" /><path d="M8 7V4h8v3M3 12a25 25 0 0 0 18 0m-9 0v3" /></>}
  {kind === 'chevron' && <path d="m7 10 5 5 5-5" />}
</svg>
