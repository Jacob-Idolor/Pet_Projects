---
interface Props { kind: string; }
const { kind } = Astro.props;
---
<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {kind === 'twitch' && <><path d="M5 3h16v12l-5 5h-5l-4 3v-3H3V7l2-4Z" /><path d="M9 8v5m6-5v5" /></>}
  {kind === 'youtube' && <><rect x="2" y="5" width="20" height="14" rx="4" /><path d="m10 9 5 3-5 3Z" fill="currentColor" stroke="none" /></>}
  {kind === 'instagram' && <><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none" /></>}
  {kind === 'linkedin' && <><rect x="3" y="3" width="18" height="18" rx="4" /><path d="M8 10v7m4 0v-7m0 3a3 3 0 0 1 6 0v4" /><circle cx="8" cy="7" r=".8" fill="currentColor" stroke="none" /></>}
  {kind === 'arrow' && <path d="M6 18 18 6M6 6h12v12" />}
  {kind === 'briefcase' && <><rect x="3" y="7" width="18" height="14" rx="3" /><path d="M8 7V4h8v3M3 12a25 25 0 0 0 18 0m-9 0v3" /></>}
  {kind === 'chevron' && <path d="m7 10 5 5 5-5" />}
</svg>
