---
import seed from "../data/submissions.json";

const seedJson = JSON.stringify(seed.submissions);
const web3formsKey =
  (typeof import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY === "string"
    ? import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY.trim()
    : "") || "";
---

<section class="submissions-panel" id="submissions">
  <div class="submissions-header">
    <div>
      <p class="board-eyebrow">Friend suggestions</p>
      <h2>Drop a ticker for the group</h2>
      <p class="subtitle">
        Paste what you’d text us — tickers land in a <strong>pending queue</strong>.
        They do not join the master list until an owner adds them in git.
        {
          web3formsKey
            ? " Notes are emailed to the list owner when you submit."
            : " On this build, notes stay on your device until email delivery is configured."
        }
      </p>
    </div>
    <span class="submission-count" id="submission-count"></span>
  </div>

  <form class="submission-form" id="submission-form">
    <div class="form-row">
      <label>
        You
        <input type="text" id="submission-author" maxlength="8" placeholder="Initials" required />
      </label>
    </div>
    <label class="full-width">
      Note from the chat
      <textarea
        id="submission-content"
        rows="3"
        placeholder="Watching PLTR under $18&#10;SMH still the core semi basket&#10;Paste a ticker or a quick thesis like the group chat"
        required
      ></textarea>
    </label>
    <button type="submit" class="btn btn-primary" id="submission-submit">Suggest for master list</button>
    <p class="submission-status" id="submission-status" role="status" aria-live="polite" hidden></p>
  </form>

  <ul class="submission-list" id="submission-list" aria-live="polite"></ul>
</section>

<script is:inline define:vars={{ seedJson, web3formsKey }}>
  (function () {
    var DB = "stocks-radar-submissions";
    var KEY = "entries";
    var WEB3FORMS_URL = "https://api.web3forms.com/submit";

    function openDb() {
      return new Promise(function (resolve, reject) {
        var req = indexedDB.open(DB, 1);
        req.onupgradeneeded = function () {
          if (!req.result.objectStoreNames.contains("kv")) {
            req.result.createObjectStore("kv");
          }
        };
        req.onsuccess = function () { resolve(req.result); };
        req.onerror = function () { reject(req.error); };
      });
    }

    function getLocal() {
      return openDb().then(function (db) {
        return new Promise(function (resolve, reject) {
          var tx = db.transaction("kv", "readonly");
          var req = tx.objectStore("kv").get(KEY);
          req.onsuccess = function () { resolve(req.result || []); };
          req.onerror = function () { reject(req.error); };
        });
      }).catch(function () { return []; });
    }

    function setLocal(entries) {
      return openDb().then(function (db) {
        return new Promise(function (resolve, reject) {
          var tx = db.transaction("kv", "readwrite");
          tx.objectStore("kv").put(entries, KEY);
          tx.oncomplete = function () { resolve(); };
          tx.onerror = function () { reject(tx.error); };
        });
      });
    }

    function parseSymbols(text) {
      var found = new Set();
      var parts = text.split(/[\s,;|/]+/);
      for (var i = 0; i < parts.length; i++) {
        var p = parts[i].trim().toUpperCase().replace(/^\$/, "");
        if (/^[A-Z]{1,5}(\.[A-Z])?$/.test(p)) found.add(p);
      }
      return Array.from(found);
    }

    function formatDate(iso) {
      try {
        return new Date(iso).toLocaleDateString(undefined, {
          month: "short",
          day: "numeric",
          year: "numeric",
        });
      } catch {
        return iso;
      }
    }

    function escapeHtml(t) {
      return String(t)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    var seed = JSON.parse(seedJson);
    var form = document.getElementById("submission-form");
    var authorInput = document.getElementById("submission-author");
    var contentInput = document.getElementById("submission-content");
    var listEl = document.getElementById("submission-list");
    var countEl = document.getElementById("submission-count");
    var submitBtn = document.getElementById("submission-submit");
    var statusEl = document.getElementById("submission-status");

    var savedAuthor = localStorage.getItem("radar-author");
    if (savedAuthor && authorInput) authorInput.value = savedAuthor;

    function setStatus(message, kind) {
      if (!statusEl) return;
      if (!message) {
        statusEl.hidden = true;
        statusEl.textContent = "";
        statusEl.className = "submission-status";
        return;
      }
      statusEl.hidden = false;
      statusEl.textContent = message;
      statusEl.className =
        "submission-status" +
        (kind === "ok"
          ? " submission-status--ok"
          : kind === "warn"
            ? " submission-status--warn"
            : kind === "err"
              ? " submission-status--err"
              : "");
    }

    function allSubmissions(local) {
      var map = {};
      seed.forEach(function (s) { map[s.id] = Object.assign({ status: "noted" }, s); });
      local.forEach(function (s) { map[s.id] = s; });
      return Object.keys(map)
        .map(function (k) { return map[k]; })
        .sort(function (a, b) {
          return String(b.submittedAt).localeCompare(String(a.submittedAt));
        });
    }

    function statusLabel(sub) {
      if (sub.status === "pending" || (sub.id && String(sub.id).indexOf("local-") === 0 && sub.status !== "noted")) {
        return '<span class="sub-status sub-status--pending">Pending master list</span>';
      }
      return '<span class="sub-status sub-status--noted">On the record</span>';
    }

    function render(local) {
      var all = allSubmissions(local);
      var pending = all.filter(function (s) {
        return s.status === "pending" || String(s.id).indexOf("local-") === 0;
      }).length;
      if (countEl) {
        countEl.textContent =
          pending > 0
            ? pending + " pending · " + all.length + " notes"
            : all.length + " notes";
      }

      if (!listEl) return;
      if (!all.length) {
        listEl.innerHTML =
          '<li class="submission-empty">No suggestions yet — be the first to drop a ticker for the group.</li>';
        return;
      }
      listEl.innerHTML = all
        .map(function (sub) {
          var chips = (sub.symbols || [])
            .map(function (s) {
              return '<span class="sub-symbol">' + escapeHtml(s) + "</span>";
            })
            .join("");
          return (
            '<li class="submission-item" data-id="' +
            escapeHtml(sub.id) +
            '">' +
            '<div class="submission-meta">' +
            "<strong>" +
            escapeHtml(sub.author) +
            "</strong>" +
            "<time>" +
            formatDate(sub.submittedAt) +
            "</time>" +
            statusLabel(sub) +
            "</div>" +
            (chips ? '<div class="submission-symbols">' + chips + "</div>" : "") +
            '<p class="submission-text">' +
            escapeHtml(sub.content) +
            "</p>" +
            (String(sub.id).indexOf("local-") === 0
              ? '<button type="button" class="btn-text delete-sub" data-id="' +
                escapeHtml(sub.id) +
                '">Remove suggestion</button>'
              : "") +
            "</li>"
          );
        })
        .join("");

      listEl.querySelectorAll(".delete-sub").forEach(function (btn) {
        btn.addEventListener("click", async function () {
          var id = btn.getAttribute("data-id");
          var entries = await getLocal();
          await setLocal(entries.filter(function (e) { return e.id !== id; }));
          render(await getLocal());
        });
      });
    }

    function deliverToOwner(sub) {
      if (!web3formsKey) {
        return Promise.resolve({ ok: false, skipped: true });
      }
      return fetch(WEB3FORMS_URL, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify({
          access_key: web3formsKey,
          subject: "StocksWatch suggestion from " + sub.author,
          from_name: "StocksWatch",
          author: sub.author,
          content: sub.content,
          symbols: (sub.symbols || []).join(", ") || "(none detected)",
          submittedAt: sub.submittedAt,
          page: typeof location !== "undefined" ? location.href : "",
          submissionId: sub.id,
        }),
      }).then(function (res) {
        return res.json().then(function (data) {
          return { ok: Boolean(res.ok && data && data.success), skipped: false, data: data };
        }).catch(function () {
          return { ok: false, skipped: false };
        });
      }).catch(function () {
        return { ok: false, skipped: false };
      });
    }

    async function init() {
      render(await getLocal());
    }

    form?.addEventListener("submit", async function (e) {
      e.preventDefault();
      var author = (authorInput?.value || "").trim().toUpperCase();
      var content = (contentInput?.value || "").trim();
      if (!author || !content) return;
      if (submitBtn && submitBtn.disabled) return;

      localStorage.setItem("radar-author", author);

      var sub = {
        id: "local-" + crypto.randomUUID(),
        author: author,
        submittedAt: new Date().toISOString().slice(0, 10),
        content: content,
        symbols: parseSymbols(content),
        status: "pending",
      };

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Sending…";
      }
      setStatus("", null);

      var local = await getLocal();
      local.push(sub);
      await setLocal(local);

      if (contentInput) contentInput.value = "";
      render(local);

      var delivery = await deliverToOwner(sub);
      if (delivery.skipped) {
        setStatus(
          "Saved on this device only — email delivery isn’t configured on this build.",
          "warn"
        );
      } else if (delivery.ok) {
        setStatus(
          "Sent — you’ll show as pending until it’s on the master list.",
          "ok"
        );
      } else {
        setStatus(
          "Saved on this device, but email didn’t go through. Try again later or ping the list owner.",
          "err"
        );
      }

      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Suggest for master list";
      }
      // Master list stays git-owned — no auto-merge into the board
    });

    init();
  })();
</script>
