---
import seed from "../data/submissions.json";

const seedJson = JSON.stringify(seed.submissions);
---

<section class="submissions-panel" id="submissions">
  <div class="submissions-header">
    <div>
      <h2>Group radar feed</h2>
      <p class="subtitle">Tickers, notes, paste from chat — anything you want on the list. Grows as you submit.</p>
    </div>
    <span class="submission-count" id="submission-count"></span>
  </div>

  <form class="submission-form" id="submission-form">
    <div class="form-row">
      <label>
        You
        <input type="text" id="submission-author" maxlength="8" placeholder="Initials" required />
      </label>
    </div>
    <label class="full-width">
      Add to the radar
      <textarea
        id="submission-content"
        rows="3"
        placeholder="SMH top semi exposure&#10;Watching PLTR under $18&#10;Paste a few tickers or a quick note — whatever you use in the group chat"
        required
      ></textarea>
    </label>
    <button type="submit" class="btn btn-primary">Add to feed</button>
  </form>

  <ul class="submission-list" id="submission-list" aria-live="polite"></ul>
</section>

<script is:inline define:vars={{ seedJson }}>
  (function () {
    var DB = "stocks-radar-submissions";
    var KEY = "entries";

    function openDb() {
      return new Promise(function (resolve, reject) {
        var req = indexedDB.open(DB, 1);
        req.onupgradeneeded = function () {
          if (!req.result.objectStoreNames.contains("kv")) {
            req.result.createObjectStore("kv");
          }
        };
        req.onsuccess = function () { resolve(req.result); };
        req.onerror = function () { reject(req.error); };
      });
    }

    function getLocal() {
      return openDb().then(function (db) {
        return new Promise(function (resolve, reject) {
          var tx = db.transaction("kv", "readonly");
          var req = tx.objectStore("kv").get(KEY);
          req.onsuccess = function () { resolve(req.result || []); };
          req.onerror = function () { reject(req.error); };
        });
      }).catch(function () { return []; });
    }

    function setLocal(entries) {
      return openDb().then(function (db) {
        return new Promise(function (resolve, reject) {
          var tx = db.transaction("kv", "readwrite");
          tx.objectStore("kv").put(entries, KEY);
          tx.oncomplete = function () { resolve(); };
          tx.onerror = function () { reject(tx.error); };
        });
      });
    }

    function parseSymbols(text) {
      var found = new Set();
      var parts = text.split(/[\s,;|/]+/);
      for (var i = 0; i < parts.length; i++) {
        var p = parts[i].trim().toUpperCase().replace(/^\$/, "");
        if (/^[A-Z]{1,5}(\.[A-Z])?$/.test(p)) found.add(p);
      }
      return Array.from(found);
    }

    function parseTargetFromContent(content, symbol) {
      var sym = symbol.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
      var patterns = [
        new RegExp(sym + "[^\\d]{0,24}(?:\\$|@|under|below|at|to)?\\s*(\\d+(?:\\.\\d+)?)", "i"),
        new RegExp("(?:\\$|@|target|pt|under|below)\\s*(\\d+(?:\\.\\d+)?)[^\\d]{0,24}" + sym, "i"),
      ];
      for (var i = 0; i < patterns.length; i++) {
        var m = content.match(patterns[i]);
        if (m) return parseFloat(m[1]);
      }
      return null;
    }

    function stocksFromSubmission(sub) {
      return sub.symbols.map(function (sym) {
        var tp = parseTargetFromContent(sub.content, sym);
        var cat = tp != null ? "targets" : "watching";
        var stock = {
          id: "sub-" + sym.toLowerCase() + "-" + cat + "-" + sub.id,
          symbol: sym,
          name: sym,
          category: cat,
          thesis: sub.content,
          addedBy: sub.author,
          custom: true,
        };
        if (tp != null) {
          stock.targetPrice = tp;
          stock.targetNote = sub.content;
        }
        return stock;
      });
    }

    function mergeById(a, b) {
      var map = {};
      a.concat(b).forEach(function (s) { map[s.id] = s; });
      return Object.keys(map).map(function (k) { return map[k]; });
    }

    function formatDate(iso) {
      try {
        return new Date(iso).toLocaleDateString(undefined, { month: "short", day: "numeric", year: "numeric" });
      } catch {
        return iso;
      }
    }

    function escapeHtml(t) {
      return String(t)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    var seed = JSON.parse(seedJson);
    var form = document.getElementById("submission-form");
    var authorInput = document.getElementById("submission-author");
    var contentInput = document.getElementById("submission-content");
    var listEl = document.getElementById("submission-list");
    var countEl = document.getElementById("submission-count");

    var savedAuthor = localStorage.getItem("radar-author");
    if (savedAuthor && authorInput) authorInput.value = savedAuthor;

    function allSubmissions(local) {
      var map = {};
      seed.forEach(function (s) { map[s.id] = s; });
      local.forEach(function (s) { map[s.id] = s; });
      return Object.keys(map).map(function (k) { return map[k]; })
        .sort(function (a, b) { return String(b.submittedAt).localeCompare(String(a.submittedAt)); });
    }

    function render(local) {
      var all = allSubmissions(local);
      if (countEl) countEl.textContent = all.length + " on the feed";

      if (!listEl) return;
      listEl.innerHTML = all.map(function (sub) {
        var chips = (sub.symbols || []).map(function (s) {
          return '<span class="sub-symbol">' + escapeHtml(s) + '</span>';
        }).join("");
        var localTag = sub.id.indexOf("local-") === 0 ? ' <span class="local-tag">new</span>' : "";
        return '<li class="submission-item" data-id="' + escapeHtml(sub.id) + '">' +
          '<div class="submission-meta">' +
          '<strong>' + escapeHtml(sub.author) + '</strong>' +
          '<time>' + formatDate(sub.submittedAt) + '</time>' + localTag +
          '</div>' +
          (chips ? '<div class="submission-symbols">' + chips + '</div>' : "") +
          '<p class="submission-text">' + escapeHtml(sub.content) + '</p>' +
          (sub.id.indexOf("local-") === 0
            ? '<button type="button" class="btn-text delete-sub" data-id="' + escapeHtml(sub.id) + '">Remove</button>'
            : "") +
          '</li>';
      }).join("");

      listEl.querySelectorAll(".delete-sub").forEach(function (btn) {
        btn.addEventListener("click", async function () {
          var id = btn.getAttribute("data-id");
          var entries = await getLocal();
          await setLocal(entries.filter(function (e) { return e.id !== id; }));
          render(await getLocal());
        });
      });
    }

    async function init() {
      var local = await getLocal();
      render(local);

      var all = allSubmissions(local);
      var stocks = [];
      all.forEach(function (sub) {
        stocks = mergeById(stocks, stocksFromSubmission(sub));
      });
      if (stocks.length) {
        document.dispatchEvent(new CustomEvent("radar:submission-added", { detail: { stocks: stocks } }));
      }
    }

    form?.addEventListener("submit", async function (e) {
      e.preventDefault();
      var author = (authorInput?.value || "").trim().toUpperCase();
      var content = (contentInput?.value || "").trim();
      if (!author || !content) return;

      localStorage.setItem("radar-author", author);

      var sub = {
        id: "local-" + crypto.randomUUID(),
        author: author,
        submittedAt: new Date().toISOString().slice(0, 10),
        content: content,
        symbols: parseSymbols(content),
      };

      var local = await getLocal();
      local.push(sub);
      await setLocal(local);

      if (contentInput) contentInput.value = "";
      render(local);

      var stocks = stocksFromSubmission(sub);
      if (stocks.length) {
        document.dispatchEvent(new CustomEvent("radar:submission-added", { detail: { stocks: stocks } }));
      }
    });

    init();
  })();
</script>
