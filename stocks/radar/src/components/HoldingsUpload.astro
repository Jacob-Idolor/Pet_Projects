<section class="holdings-panel" id="holdings">
  <h2>📸 Holdings Screenshots</h2>
  <p class="subtitle">
    Drop broker screenshots here — tickers only, no dollar amounts needed.
    Images stay in <strong>your browser</strong> so nothing leaves your device.
  </p>

  <div class="holdings-controls">
    <label>
      Your initials
      <input type="text" id="holder-name" maxlength="4" placeholder="e.g. J" />
    </label>
    <button type="button" class="btn btn-ghost" id="clear-all-screenshots">Clear my uploads</button>
  </div>

  <div class="drop-zone" id="drop-zone" role="button" tabindex="0" aria-label="Upload holdings screenshot">
    <div class="drop-zone-icon">🖼️</div>
    <p>Drag & drop a screenshot, or click to browse</p>
    <p class="hint">PNG, JPG, or WebP · stored locally in IndexedDB</p>
  </div>
  <input type="file" id="file-input" accept="image/png,image/jpeg,image/webp" hidden />

  <div class="screenshot-grid" id="screenshot-grid"></div>
  <div class="empty-holdings" id="empty-holdings" hidden>
    No screenshots yet — upload your first holdings pic above.
  </div>
</section>

<div class="lightbox" id="lightbox" aria-hidden="true">
  <img id="lightbox-img" alt="Holdings screenshot full size" />
</div>

<script>
  const DB_NAME = "stocks-radar-holdings";
  const STORE = "screenshots";
  const DB_VERSION = 1;

  interface ScreenshotRecord {
    id: string;
    holder: string;
    blob: Blob;
    addedAt: number;
  }

  function openDb(): Promise<IDBDatabase> {
    return new Promise((resolve, reject) => {
      const req = indexedDB.open(DB_NAME, DB_VERSION);
      req.onupgradeneeded = () => {
        const db = req.result;
        if (!db.objectStoreNames.contains(STORE)) {
          db.createObjectStore(STORE, { keyPath: "id" });
        }
      };
      req.onsuccess = () => resolve(req.result);
      req.onerror = () => reject(req.error);
    });
  }

  async function getAll(): Promise<ScreenshotRecord[]> {
    const db = await openDb();
    return new Promise((resolve, reject) => {
      const tx = db.transaction(STORE, "readonly");
      const req = tx.objectStore(STORE).getAll();
      req.onsuccess = () => resolve(req.result as ScreenshotRecord[]);
      req.onerror = () => reject(req.error);
    });
  }

  async function put(record: ScreenshotRecord): Promise<void> {
    const db = await openDb();
    return new Promise((resolve, reject) => {
      const tx = db.transaction(STORE, "readwrite");
      tx.objectStore(STORE).put(record);
      tx.oncomplete = () => resolve();
      tx.onerror = () => reject(tx.error);
    });
  }

  async function remove(id: string): Promise<void> {
    const db = await openDb();
    return new Promise((resolve, reject) => {
      const tx = db.transaction(STORE, "readwrite");
      tx.objectStore(STORE).delete(id);
      tx.oncomplete = () => resolve();
      tx.onerror = () => reject(tx.error);
    });
  }

  async function removeByHolder(holder: string): Promise<void> {
    const all = await getAll();
    await Promise.all(all.filter((r) => r.holder === holder).map((r) => remove(r.id)));
  }

  function formatWhen(ts: number): string {
    return new Date(ts).toLocaleDateString(undefined, {
      month: "short",
      day: "numeric",
      hour: "numeric",
      minute: "2-digit",
    });
  }

  const holderInput = document.getElementById("holder-name") as HTMLInputElement;
  const dropZone = document.getElementById("drop-zone")!;
  const fileInput = document.getElementById("file-input") as HTMLInputElement;
  const grid = document.getElementById("screenshot-grid")!;
  const emptyEl = document.getElementById("empty-holdings")!;
  const lightbox = document.getElementById("lightbox")!;
  const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;
  const clearBtn = document.getElementById("clear-all-screenshots")!;

  const savedName = localStorage.getItem("radar-holder-name");
  if (savedName) holderInput.value = savedName;
  holderInput.addEventListener("change", () => {
    localStorage.setItem("radar-holder-name", holderInput.value.trim().toUpperCase());
  });

  const objectUrls: string[] = [];

  async function renderGrid() {
    objectUrls.forEach((u) => URL.revokeObjectURL(u));
    objectUrls.length = 0;
    grid.innerHTML = "";

    const records = (await getAll()).sort((a, b) => b.addedAt - a.addedAt);
    emptyEl.hidden = records.length > 0;

    for (const rec of records) {
      const url = URL.createObjectURL(rec.blob);
      objectUrls.push(url);

      const card = document.createElement("div");
      card.className = "screenshot-card";
      card.innerHTML = `
        <img src="${url}" alt="Holdings screenshot from ${rec.holder}" loading="lazy" />
        <div class="screenshot-meta">
          <div>
            <span class="who">${rec.holder}</span>
            <span class="when">${formatWhen(rec.addedAt)}</span>
          </div>
          <button type="button" aria-label="Delete screenshot">✕</button>
        </div>
      `;

      card.querySelector("img")!.addEventListener("click", () => {
        lightboxImg.src = url;
        lightbox.classList.add("open");
        lightbox.setAttribute("aria-hidden", "false");
      });

      card.querySelector("button")!.addEventListener("click", async (e) => {
        e.stopPropagation();
        await remove(rec.id);
        await renderGrid();
      });

      grid.appendChild(card);
    }
  }

  async function handleFiles(files: FileList | File[]) {
    const holder = holderInput.value.trim().toUpperCase() || "?";
    localStorage.setItem("radar-holder-name", holder);

    for (const file of Array.from(files)) {
      if (!file.type.startsWith("image/")) continue;
      await put({
        id: crypto.randomUUID(),
        holder,
        blob: file,
        addedAt: Date.now(),
      });
    }
    await renderGrid();
  }

  dropZone.addEventListener("click", () => fileInput.click());
  dropZone.addEventListener("keydown", (e) => {
    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      fileInput.click();
    }
  });

  dropZone.addEventListener("dragover", (e) => {
    e.preventDefault();
    dropZone.classList.add("dragover");
  });
  dropZone.addEventListener("dragleave", () => dropZone.classList.remove("dragover"));
  dropZone.addEventListener("drop", (e) => {
    e.preventDefault();
    dropZone.classList.remove("dragover");
    if (e.dataTransfer?.files.length) handleFiles(e.dataTransfer.files);
  });

  fileInput.addEventListener("change", () => {
    if (fileInput.files?.length) handleFiles(fileInput.files);
    fileInput.value = "";
  });

  clearBtn.addEventListener("click", async () => {
    const holder = holderInput.value.trim().toUpperCase();
    if (!holder) {
      alert("Enter your initials first.");
      return;
    }
    if (!confirm(`Delete all screenshots uploaded as "${holder}"?`)) return;
    await removeByHolder(holder);
    await renderGrid();
  });

  lightbox.addEventListener("click", () => {
    lightbox.classList.remove("open");
    lightbox.setAttribute("aria-hidden", "true");
    lightboxImg.src = "";
  });

  renderGrid();
</script>
