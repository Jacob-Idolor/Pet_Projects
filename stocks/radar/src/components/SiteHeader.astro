---
interface Props {
  /** Which primary nav item is current */
  active?: "watchlist" | "datacenter";
}

const { active = "datacenter" } = Astro.props;
const base = import.meta.env.BASE_URL;
const watchlistHref = `${base}watchlist.html`.replace(/\/{2,}/g, "/").replace(":/", "://");
---

<header class="site-header">
  <div class="site-header__inner container">
    <a class="logo" href={base}>
      <span class="logo-mark" aria-hidden="true"></span>
      StocksWatch
    </a>
    <nav class="header-nav" aria-label="Primary">
      <a
        class:list={["header-link", { "is-active": active === "datacenter" }]}
        href={base}
        aria-current={active === "datacenter" ? "page" : undefined}
      >
        AI Data Center
      </a>
      <a
        class:list={["header-link", { "is-active": active === "watchlist" }]}
        href={watchlistHref}
        aria-current={active === "watchlist" ? "page" : undefined}
      >
        Watchlist
        <span class="header-link__hint">archive</span>
      </a>
    </nav>
  </div>
</header>

<style is:global>
  /* Shared chrome — used by Home (via global.css) and Datacenter layout.
     Keep rules identical; Datacenter imports this component instead of duplicating markup. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    backdrop-filter: blur(10px);
    background: color-mix(in srgb, var(--bg, #05070a) 82%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--border, #2a3140) 70%, transparent);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.25rem;
    padding-block: 0.35rem;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display, Georgia, serif);
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--text, #e8ecf4);
    text-decoration: none;
  }
  .logo-mark {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 2px;
    background: linear-gradient(135deg, #c4a574, #8b6914);
  }
  .header-nav {
    display: flex;
    gap: 0.35rem;
  }
  .header-link {
    padding: 0.4rem 0.7rem;
    border-radius: 6px;
    color: var(--muted, #9aa3b5);
    text-decoration: none;
    font-size: 0.92rem;
  }
  .header-link:hover {
    color: var(--text, #e8ecf4);
    background: color-mix(in srgb, var(--panel, #12161c) 80%, transparent);
  }
  .header-link.is-active {
    color: var(--text, #e8ecf4);
    background: color-mix(in srgb, var(--panel, #12161c) 100%, transparent);
  }
  .header-link:focus-visible {
    outline: 2px solid var(--accent, #22c55e);
    outline-offset: 2px;
  }
  .header-link__hint {
    display: inline-block;
    margin-left: 0.25rem;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--dim, #51657d);
    vertical-align: middle;
  }
  .logo:focus-visible {
    outline: 2px solid var(--accent, #22c55e);
    outline-offset: 3px;
  }
</style>
