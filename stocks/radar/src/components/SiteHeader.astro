---
interface Props {
  /** Which primary nav item is current */
  active?: "nbis";
}

const { active = "nbis" } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<header class="site-header">
  <div class="site-header__inner container">
    <a class="logo" href={base}>
      <span class="logo-mark" aria-hidden="true"></span>
      StocksWatch
    </a>
    <div class="header-actions">
      <nav class="header-nav" aria-label="Primary">
        <a
          class:list={["header-link", { "is-active": active === "nbis" }]}
          href={base}
          aria-current={active === "nbis" ? "page" : undefined}
        >
          NBIS Deep Dive
        </a>
      </nav>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-pressed="false" aria-label="Switch to light mode" title="Switch to light mode">
        <span class="theme-toggle__glyph" aria-hidden="true">☼</span>
        <span id="theme-toggle-label">Dark</span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  const themeToggle = document.querySelector("#theme-toggle");
  const themeGlyph = document.querySelector(".theme-toggle__glyph");
  const themeLabel = document.querySelector("#theme-toggle-label");

  const syncThemeToggle = () => {
    const isLight = document.documentElement.dataset.theme === "light";
    const nextLabel = isLight ? "Switch to dark mode" : "Switch to light mode";
    themeToggle?.setAttribute("aria-pressed", String(isLight));
    themeToggle?.setAttribute("aria-label", nextLabel);
    themeToggle?.setAttribute("title", nextLabel);
    if (themeGlyph) themeGlyph.textContent = isLight ? "☾" : "☼";
    if (themeLabel) themeLabel.textContent = isLight ? "Light" : "Dark";
  };

  themeToggle?.addEventListener("click", () => {
    const nextTheme = document.documentElement.dataset.theme === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = nextTheme;
    try {
      localStorage.setItem("stockswatch-theme", nextTheme);
    } catch {}
    syncThemeToggle();
  });

  syncThemeToggle();
</script>

<style is:global>
  /* Shared chrome — used by Home (via global.css) and Datacenter layout.
     Keep rules identical; Datacenter imports this component instead of duplicating markup. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    backdrop-filter: blur(10px);
    background: color-mix(in srgb, var(--bg, #05070a) 82%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--border, #2a3140) 70%, transparent);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.25rem;
    padding-block: 0.35rem;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display, Georgia, serif);
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--text, #e8ecf4);
    text-decoration: none;
  }
  .logo-mark {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 2px;
    background: linear-gradient(135deg, #c4a574, #8b6914);
  }
  .header-nav {
    display: flex;
    gap: 0.35rem;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .header-link {
    padding: 0.4rem 0.7rem;
    border-radius: 6px;
    color: var(--muted, #9aa3b5);
    text-decoration: none;
    font-size: 0.92rem;
  }
  .header-link:hover {
    color: var(--text, #e8ecf4);
    background: color-mix(in srgb, var(--panel, #12161c) 80%, transparent);
  }
  .header-link.is-active {
    color: var(--text, #e8ecf4);
    background: color-mix(in srgb, var(--panel, #12161c) 100%, transparent);
  }
  .header-link:focus-visible {
    outline: 2px solid var(--accent, #22c55e);
    outline-offset: 2px;
  }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2rem;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--border, #2a3140);
    border-radius: 999px;
    color: var(--muted, #9aa3b5);
    background: color-mix(in srgb, var(--panel, #12161c) 70%, transparent);
    font: inherit;
    font-size: 0.78rem;
    cursor: pointer;
  }
  .theme-toggle:hover {
    color: var(--text, #e8ecf4);
    border-color: var(--accent, #22c55e);
  }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent, #22c55e);
    outline-offset: 2px;
  }
  .theme-toggle__glyph {
    display: inline-grid;
    place-items: center;
    width: 1rem;
    height: 1rem;
    color: var(--accent, #22c55e);
    font-size: 0.9rem;
  }
  .header-link__hint {
    display: inline-block;
    margin-left: 0.25rem;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--dim, #51657d);
    vertical-align: middle;
  }
  .logo:focus-visible {
    outline: 2px solid var(--accent, #22c55e);
    outline-offset: 3px;
  }
</style>
