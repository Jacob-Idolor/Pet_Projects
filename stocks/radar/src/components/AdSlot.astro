---
import { canShowAdSlot, getAdSenseConfig, slotIdFor } from "../lib/adsense";

interface Props {
  placement: "hero" | "board" | "footer";
  /** Accessible label for the region — use “Sponsored”, not navigation chrome */
  label?: string;
  class?: string;
}

const { placement, label = "Sponsored", class: className = "" } = Astro.props;
const ads = getAdSenseConfig();
const slot = slotIdFor(ads, placement);

/** Live units need client + slot. Preview boxes are local/dev only — never ship those hints to production. */
const allowed = canShowAdSlot(ads, placement);
const showLive = allowed && ads.enabled && Boolean(slot) && Boolean(ads.client);
const show = allowed && (showLive || ads.preview);
---

{
  show && (
    <aside
      class={`ad-slot ad-slot--${placement} ${className}`.trim()}
      aria-label={label}
      data-ad-placement={placement}
      data-ad-mode={showLive ? "live" : "preview"}
    >
      <p class="ad-slot__label">{label}</p>
      {showLive ? (
        <>
          <ins
            class="adsbygoogle"
            style="display:block"
            data-ad-client={ads.client}
            data-ad-slot={slot}
            data-ad-format="auto"
            data-full-width-responsive="true"
          />
          <script is:inline>
            (window.adsbygoogle = window.adsbygoogle || []).push({});
          </script>
        </>
      ) : (
        <div class="ad-slot-preview">
          <span class="ad-slot-preview__badge">AdSense preview</span>
          <span class="ad-slot-preview__place">{placement}</span>
          <p class="ad-slot-preview__hint">
            Local layout placeholder (after publisher content). Production units
            need approval + <code>PUBLIC_ADSENSE_SLOT_*</code>.
          </p>
        </div>
      )}
    </aside>
  )
}
