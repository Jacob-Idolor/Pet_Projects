---
import type { Stock } from "../data/watchlist";
import { formatPrice, distanceToTarget } from "../data/watchlist";

interface Props {
  stock: Stock;
}

const { stock } = Astro.props;
const dist = distanceToTarget(stock.lastPrice, stock.targetPrice);
---

<article class="stock-card" data-symbol={stock.symbol}>
  <div class="stock-card-header">
    <div>
      <div class="stock-symbol">{stock.symbol}</div>
      <div class="stock-name">{stock.name}</div>
    </div>
    <div class="stock-badges">
      {stock.holder && <span class="badge holder">{stock.holder}</span>}
      {stock.addedBy && !stock.holder && <span class="badge">{stock.addedBy}</span>}
    </div>
  </div>

  <div class="price-row">
    <span class="live-price loading" data-live-price={stock.symbol}>
      {stock.lastPrice != null ? formatPrice(stock.lastPrice) : "—"}
    </span>
    <span class="price-change" data-live-change={stock.symbol} hidden></span>
  </div>

  {
    stock.targetPrice != null && (
      <div class="target-block">
        <div class="target-row">
          <span class="label">Target</span>
          <span class="value">{formatPrice(stock.targetPrice)}</span>
        </div>
        {dist && (
          <div class={`target-distance ${dist.direction}`} data-target-distance={stock.symbol}>
            {dist.label}
          </div>
        )}
        {stock.targetNote && <div class="target-note">{stock.targetNote}</div>}
      </div>
    )
  }

  {stock.thesis && <p class="thesis">{stock.thesis}</p>}
</article>

<script define:vars={{ symbol: stock.symbol, targetPrice: stock.targetPrice ?? null }}>
  document.addEventListener("radar:quotes", (e) => {
    const quotes = e.detail;
    const q = quotes[symbol];
    if (!q) return;

    const priceEl = document.querySelector(`[data-live-price="${symbol}"]`);
    const changeEl = document.querySelector(`[data-live-change="${symbol}"]`);
    const distEl = document.querySelector(`[data-target-distance="${symbol}"]`);

    if (priceEl) {
      priceEl.textContent = q.price.toLocaleString("en-US", {
        style: "currency",
        currency: "USD",
        minimumFractionDigits: 2,
      });
      priceEl.classList.remove("loading");
    }

    if (changeEl && q.changePct != null) {
      const sign = q.changePct >= 0 ? "+" : "";
      changeEl.textContent = `${sign}${q.changePct.toFixed(2)}%`;
      changeEl.classList.toggle("up", q.changePct >= 0);
      changeEl.classList.toggle("down", q.changePct < 0);
      changeEl.hidden = false;
    }

    if (distEl && targetPrice != null && targetPrice !== 0) {
      const pct = ((q.price - targetPrice) / targetPrice) * 100;
      const abs = Math.abs(pct);
      let label, direction;
      if (abs < 0.5) {
        label = "At target";
        direction = "at";
      } else if (pct > 0) {
        label = `${abs.toFixed(1)}% above target`;
        direction = "above";
      } else {
        label = `${abs.toFixed(1)}% below target`;
        direction = "below";
      }
      distEl.textContent = label;
      distEl.className = `target-distance ${direction}`;
    }
  });
</script>
