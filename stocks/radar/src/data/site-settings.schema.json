{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stocks Radar site settings",
  "type": "object",
  "required": ["app", "features", "quotes", "board", "alerts"],
  "properties": {
    "app": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "environment": {
          "type": "string",
          "enum": ["development", "staging", "production"]
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "quotes": {
      "type": "object",
      "properties": {
        "staleAfterHours": { "type": "number", "minimum": 1, "maximum": 72 },
        "pollIntervalMs": { "type": "number", "minimum": 15000 },
        "browserFallback": { "type": "boolean" },
        "yahooChunkSize": { "type": "number", "minimum": 1, "maximum": 20 },
        "yahooMaxRetries": { "type": "number", "minimum": 1, "maximum": 5 }
      }
    },
    "board": {
      "type": "object",
      "properties": {
        "defaultPageSize": { "type": "number" },
        "defaultSort": { "type": "string" },
        "defaultView": { "type": "string", "enum": ["table", "technical"] },
        "pageSizeOptions": {
          "type": "array",
          "items": { "type": "number" }
        }
      }
    },
    "alerts": {
      "type": "object",
      "properties": {
        "defaultCooldownHours": { "type": "number", "minimum": 1 },
        "nearTargetPct": { "type": "number", "minimum": 0.5 },
        "minBuyScore": { "type": "number" },
        "onlyOnSignal": { "type": "boolean" }
      }
    },
    "seo": { "type": "object" },
    "ops": { "type": "object" }
  }
}
