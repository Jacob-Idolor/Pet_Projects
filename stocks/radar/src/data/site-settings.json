{
  "$schema": "./site-settings.schema.json",
  "app": {
    "name": "StocksWatch",
    "version": "0.2.0",
    "environment": "production"
  },
  "features": {
    "adsense": true,
    "personalAlerts": false,
    "groupSubmissions": true,
    "checkInPulse": true,
    "technicalView": true,
    "dayMood": true,
    "otelScripts": false
  },
  "quotes": {
    "staleAfterHours": 6,
    "pollIntervalMs": 60000,
    "browserFallback": true,
    "yahooChunkSize": 8,
    "yahooMaxRetries": 3
  },
  "board": {
    "defaultPageSize": 50,
    "defaultSort": "symbol",
    "defaultView": "table",
    "pageSizeOptions": [25, 50, 100]
  },
  "alerts": {
    "defaultCooldownHours": 24,
    "nearTargetPct": 5,
    "minBuyScore": 3,
    "onlyOnSignal": true
  },
  "seo": {
    "requireCustomDomainForAds": true
  },
  "ops": {
    "healthPath": "/health.json",
    "settingsPath": "/settings.json",
    "budgetUsd": 3
  }
}
