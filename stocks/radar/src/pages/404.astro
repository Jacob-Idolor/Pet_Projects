---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found" description="That page is not on Stocks Radar.">
  <div class="container" style="padding: 3rem 1.15rem 4rem; text-align: center;">
    <p class="hero-brand">Stocks Radar</p>
    <h1 style="margin: 0.35rem 0 0.75rem; font-size: 1.75rem;">Page not found</h1>
    <p style="color: var(--muted); max-width: 28rem; margin: 0 auto 1.5rem;">
      The ticker board is at the home page. If a file 404'd (quotes, board script), redeploy so assets are in the bucket.
    </p>
    <a class="btn btn-primary" href={import.meta.env.BASE_URL}>Back to watchlist</a>
  </div>
</BaseLayout>
