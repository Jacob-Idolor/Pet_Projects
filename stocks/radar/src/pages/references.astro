---
import Layout from '../layouts/PersonalLayout.astro';
import PodcastReference from '../components/PodcastReference.astro';
import { books } from '../data/references';
---
<Layout title="References & inspiration" description="Books, podcasts and original sources behind Jacob's reviews and reflections.">
<div class="creator-page">
<header class="links-intro wrap"><p class="eyebrow">The source shelf</p><h1>References &amp; inspiration</h1><p class="lead">Books, conversations and ideas I keep coming back to. A growing collection of original sources behind my reviews and reflections.</p><p>This is a reference shelf, not a claim that every review has been published. Links go to the original creator or publisher, and do not contain affiliate tags.</p><div class="inline-links"><a href="#books">Books</a><a href="#podcast-reference">Podcasts &amp; videos</a></div></header>
<section class="hub-section wrap" id="books" tabindex="-1" aria-labelledby="books-title"><h2 id="books-title">On the bookshelf</h2><div class="book-grid">{books.map(book => <article class="book-reference"><p class="eyebrow">{book.category}</p><h3>{book.title}</h3><p class="author">{book.author}</p><p>{book.context}</p><a href={book.url} target="_blank" rel="noopener noreferrer">Publisher details<span class="sr-only"> for {book.title} (opens in a new tab)</span></a></article>)}</div></section>
<PodcastReference />
<aside class="wrap attribution"><h2>A note on sources</h2><p>These works belong to their respective authors, publishers and creators. Mentioning a work is not an endorsement by its creator, and personal reflections are not a substitute for professional advice. Follow the original links for the full context.</p></aside>
</div>
</Layout>
<style>.book-grid { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin-top:24px }.book-reference {padding:24px;border:1px solid var(--line);border-radius:18px;background:#fff;min-width:0}.book-reference h3 {font-size:26px;line-height:1.2}.book-reference p {color:var(--muted)}.book-reference .author{font-weight:700}.attribution{padding-block:24px 64px}@media(max-width:900px){.book-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:550px){.book-grid{grid-template-columns:1fr}}</style>
