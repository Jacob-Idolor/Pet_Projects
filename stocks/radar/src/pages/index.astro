---
import BaseLayout from "../layouts/BaseLayout.astro";
import LiveStatus from "../components/LiveStatus.astro";
import DayMoodBanner from "../components/DayMoodBanner.astro";
import CheckInPulse from "../components/CheckInPulse.astro";
import WatchlistBoard from "../components/WatchlistBoard.astro";
import GroupSubmissions from "../components/GroupSubmissions.astro";
import AdSlot from "../components/AdSlot.astro";
import { meta, stocks } from "../data/watchlist";
import { canShowAdSlot, getAdSenseConfig } from "../lib/adsense";
import { featureEnabled, getSiteSettings } from "../lib/site-config";

const description =
  meta.tagline ||
  "Group check-in: pulse with gainers, losers, watch names, and lean buy/sell in plain English.";

const settings = getSiteSettings();
const ads = getAdSenseConfig();
const showPulse = featureEnabled("checkInPulse");
const showSubmissions = featureEnabled("groupSubmissions");
const adsFeature = featureEnabled("adsense");
const showMood = featureEnabled("dayMood");
const showHeroAd = adsFeature && canShowAdSlot(ads, "hero");
const showBoardAd = adsFeature && canShowAdSlot(ads, "board");
const showFooterAd = adsFeature && canShowAdSlot(ads, "footer");
---

<BaseLayout title={meta.groupName} description={description}>
  <div class="app-shell">
    <LiveStatus />
    {showMood && <DayMoodBanner />}
    <section class="hero container">
      <div class="hero-copy">
        <p class="hero-brand">StocksWatch</p>
        <h1>{meta.groupName}</h1>
        <p class="tagline">{meta.tagline}</p>
        <p class="hero-mobile-hint mobile-only">Pulse → list → suggest. Use the bar at the bottom anytime.</p>
      </div>
      <dl class="hero-kpis" aria-label="Watchlist summary">
        <div class="hero-kpi">
          <dt>Master list</dt>
          <dd class="mono">{stocks.length}</dd>
        </div>
        <div class="hero-kpi">
          <dt>Purpose</dt>
          <dd>Check-in</dd>
        </div>
        <div class="hero-kpi desktop-only">
          <dt>Version</dt>
          <dd class="mono">{settings.app.version}</dd>
        </div>
      </dl>
    </section>
    {
      showHeroAd && (
        <div class="container">
          <AdSlot placement="hero" label="Sponsored — top" />
        </div>
      )
    }
    <div class="container board-stage">
      {showPulse && <CheckInPulse />}
      {
        showBoardAd && (
          <AdSlot placement="board" label="Sponsored — watchlist" class="ad-slot--after-board" />
        )
      }
      <WatchlistBoard />
      {showSubmissions && <GroupSubmissions />}
      {showFooterAd && <AdSlot placement="footer" label="Sponsored — footer" />}
    </div>
  </div>
</BaseLayout>
