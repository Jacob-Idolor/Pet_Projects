---
import BaseLayout from "../layouts/BaseLayout.astro";
import AdSlot from "../components/AdSlot.astro";
import profile from "../data/nbis-profile.json";
import { canShowAdSlot, getAdSenseConfig, hasPublisherContent } from "../lib/adsense";
import { featureEnabled } from "../lib/site-config";

const base = import.meta.env.BASE_URL;
const dataUrl = `${base}nbis.json`.replace(/\/{2,}/g, "/").replace(":/", "://");
const description =
  "Daily NBIS research dashboard covering Nebius Group fundamentals, AI cloud economics, valuation assumptions, filings, price history, risks, and catalysts.";
const ads = getAdSenseConfig();
const allowAds = featureEnabled("adsense") && hasPublisherContent(5);
const showFooterAd = allowAds && canShowAdSlot(ads, "footer");
---

<BaseLayout
  title="NBIS Deep Dive"
  description={description}
  allowAds={allowAds}
  activeNav="nbis"
  canonicalPath="/"
>
  <div class="nbis-page" id="nbis-app" data-nbis-url={dataUrl}>
    <section class="nbis-hero container">
      <div class="nbis-hero__copy">
        <p class="nbis-kicker"><span class="nbis-kicker__rule" aria-hidden="true"></span>STOCKSWATCH / DAILY RESEARCH</p>
        <h1>Nebius Group <span class="nbis-ticker">NBIS</span></h1>
        <p class="nbis-lede">{profile.businessSummary}</p>
        <div class="nbis-links">
          <a href={profile.investorRelations} target="_blank" rel="noopener">Investor relations ↗</a>
          <a href={profile.website} target="_blank" rel="noopener">Company site ↗</a>
          <a href={`https://www.sec.gov/edgar/browse/?CIK=${profile.secCik}&owner=exclude`} target="_blank" rel="noopener">SEC filings ↗</a>
        </div>
      </div>
      <div class="nbis-hero__meta nbis-panel">
        <div class="nbis-meta-top"><span class="nbis-eyebrow">Live snapshot</span><span class="nbis-live-label"><span class="nbis-status__dot" aria-hidden="true"></span>LIVE</span></div>
        <div class="nbis-status nbis-status--loading" id="nbis-status" role="status" aria-live="polite">
          <span class="nbis-status__dot" aria-hidden="true"></span>
          Loading daily snapshot…
        </div>
        <p class="nbis-meta-line">{profile.exchange} · {profile.headquarters}</p>
        <p class="nbis-meta-line">Facts and provider data are time-stamped below.</p>
      </div>
    </section>

    <nav class="nbis-nav container" aria-label="NBIS research sections">
      <a href="#overview">Overview</a>
      <a href="#price">Price &amp; trend</a>
      <a href="#business">Business</a>
      <a href="#financials">Financials</a>
      <a href="#valuation">Valuation</a>
      <a href="#risks">Risks &amp; catalysts</a>
      <a href="#filings">Filings &amp; news</a>
    </nav>

    <main class="container nbis-main">
      <section id="overview" class="nbis-section" aria-labelledby="overview-title">
        <div class="nbis-section__heading">
          <div>
            <p class="nbis-eyebrow">01 / Signal board</p>
            <h2 id="overview-title">What changed today</h2>
          </div>
          <p class="nbis-section__note">Automated readouts are prompts for research, not a buy, sell, or hold signal.</p>
        </div>
        <div class="nbis-stat-grid">
          <article class="nbis-stat-card nbis-panel">
            <div class="nbis-stat-card__top"><span class="nbis-stat-card__index">01</span><span class="nbis-stat-card__label">Last price</span></div>
            <strong id="nbis-price" class="nbis-stat-card__value">—</strong>
            <span id="nbis-change" class="nbis-stat-card__sub">Awaiting snapshot</span>
          </article>
          <article class="nbis-stat-card nbis-panel">
            <div class="nbis-stat-card__top"><span class="nbis-stat-card__index">02</span><span class="nbis-stat-card__label">Market cap</span></div>
            <strong id="nbis-market-cap" class="nbis-stat-card__value">—</strong>
            <span class="nbis-stat-card__sub">Provider-reported</span>
          </article>
          <article class="nbis-stat-card nbis-panel">
            <div class="nbis-stat-card__top"><span class="nbis-stat-card__index">03</span><span class="nbis-stat-card__label">Revenue growth</span></div>
            <strong id="nbis-revenue-growth" class="nbis-stat-card__value">—</strong>
            <span class="nbis-stat-card__sub">Latest provider figure</span>
          </article>
          <article class="nbis-stat-card nbis-panel">
            <div class="nbis-stat-card__top"><span class="nbis-stat-card__index">04</span><span class="nbis-stat-card__label">Free cash flow</span></div>
            <strong id="nbis-fcf" class="nbis-stat-card__value">—</strong>
            <span class="nbis-stat-card__sub">Latest provider figure</span>
          </article>
        </div>
        <div id="nbis-readouts" class="nbis-readouts" aria-live="polite">
          <div class="nbis-empty">Loading the story behind the numbers…</div>
        </div>
      </section>

      <section id="price" class="nbis-section" aria-labelledby="price-title">
        <div class="nbis-section__heading">
          <div>
            <p class="nbis-eyebrow">02 / Market tape</p>
            <h2 id="price-title">Price, but with context</h2>
          </div>
          <p id="nbis-price-meta" class="nbis-section__note">Daily close history is fetched automatically.</p>
        </div>
        <div class="nbis-two-column nbis-two-column--wide">
          <article class="nbis-panel nbis-chart-panel">
            <div class="nbis-panel__header">
              <div>
                <h3>Five-year closing price</h3>
                <p class="nbis-muted">A chart of historical closes, not a forecast.</p>
              </div>
              <span id="nbis-chart-range" class="nbis-pill">—</span>
            </div>
            <div id="nbis-chart" class="nbis-chart" role="img" aria-label="NBIS closing price history">
              <div class="nbis-empty">Chart will appear when price history is available.</div>
            </div>
          </article>
          <article class="nbis-panel">
            <div class="nbis-panel__header"><h3>Quote snapshot</h3></div>
            <div id="nbis-quote-table" class="nbis-metric-list"><div class="nbis-empty">Loading…</div></div>
          </article>
        </div>
        <div class="nbis-two-column">
          <article class="nbis-panel">
            <div class="nbis-panel__header"><h3>Returns</h3><span class="nbis-muted">Calculated from closes</span></div>
            <div id="nbis-returns" class="nbis-return-grid"><div class="nbis-empty">Loading…</div></div>
          </article>
          <article class="nbis-panel">
            <div class="nbis-panel__header"><h3>Technical indicators</h3><span class="nbis-muted">Rules-based context</span></div>
            <div id="nbis-technicals" class="nbis-metric-list"><div class="nbis-empty">Loading…</div></div>
          </article>
        </div>
      </section>

      <section id="business" class="nbis-section" aria-labelledby="business-title">
        <div class="nbis-section__heading">
          <div>
            <p class="nbis-eyebrow">03 / The company</p>
            <h2 id="business-title">Business model and strategic map</h2>
          </div>
          <p class="nbis-section__note">Company descriptions are grounded in the linked company and filing sources.</p>
        </div>
        <div class="nbis-two-column nbis-two-column--wide">
          <article class="nbis-panel nbis-business-summary">
            <h3>How the group fits together</h3>
            <p>{profile.businessSummary}</p>
            <div class="nbis-fact-line"><span>Issuer</span><strong>{profile.company}</strong></div>
            <div class="nbis-fact-line"><span>Listing</span><strong>{profile.exchange}</strong></div>
            <div class="nbis-fact-line"><span>SEC CIK</span><strong class="nbis-mono">{profile.secCik}</strong></div>
          </article>
          <div id="nbis-business-lines" class="nbis-business-lines">
            {
              profile.businessLines.map((line) => (
                <article class="nbis-business-line nbis-panel">
                  <span class="nbis-label-chip">{line.type}</span>
                  <h3>{line.name}</h3>
                  <p>{line.description}</p>
                </article>
              ))
            }
          </div>
        </div>
        <article class="nbis-panel nbis-monitor-panel">
          <div class="nbis-panel__header"><h3>What to monitor</h3><span class="nbis-muted">Research checklist</span></div>
          <ul class="nbis-monitor-list">
            {profile.monitor.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      </section>

      <section id="financials" class="nbis-section" aria-labelledby="financials-title">
        <div class="nbis-section__heading">
          <div>
            <p class="nbis-eyebrow">04 / Reported numbers</p>
            <h2 id="financials-title">Financial performance</h2>
          </div>
          <p class="nbis-section__note">Provider statements can differ from SEC presentation. Read the filing before relying on a figure.</p>
        </div>
        <article class="nbis-panel nbis-table-panel">
          <div class="nbis-panel__header"><h3>Annual income and cash flow</h3><span class="nbis-muted">Most recent periods available</span></div>
          <div id="nbis-annual-table" class="nbis-table-wrap"><div class="nbis-empty">Loading annual statements…</div></div>
        </article>
        <article class="nbis-panel nbis-table-panel">
          <div class="nbis-panel__header"><h3>Quarterly income and cash flow</h3><span class="nbis-muted">Most recent periods available</span></div>
          <div id="nbis-quarterly-table" class="nbis-table-wrap"><div class="nbis-empty">Loading quarterly statements…</div></div>
        </article>
        <div class="nbis-two-column">
          <article class="nbis-panel">
            <div class="nbis-panel__header"><h3>Profitability and leverage</h3><span class="nbis-muted">Provider-reported</span></div>
            <div id="nbis-profitability" class="nbis-metric-list"><div class="nbis-empty">Loading…</div></div>
          </article>
          <article class="nbis-panel">
            <div class="nbis-panel__header"><h3>Balance sheet and capital</h3><span class="nbis-muted">Provider-reported</span></div>
            <div id="nbis-balance-sheet" class="nbis-metric-list"><div class="nbis-empty">Loading…</div></div>
          </article>
        </div>
      </section>

      <section id="valuation" class="nbis-section" aria-labelledby="valuation-title">
        <div class="nbis-section__heading">
          <div>
            <p class="nbis-eyebrow">05 / Expectations</p>
            <h2 id="valuation-title">Valuation and scenarios</h2>
          </div>
          <p class="nbis-section__note">Consensus is not a recommendation. Scenario outputs are assumptions, not price targets.</p>
        </div>
        <div class="nbis-two-column nbis-two-column--wide">
          <article class="nbis-panel">
            <div class="nbis-panel__header"><h3>Current valuation</h3><span class="nbis-muted">Provider-reported</span></div>
            <div id="nbis-valuation-table" class="nbis-metric-list"><div class="nbis-empty">Loading…</div></div>
          </article>
          <article class="nbis-panel nbis-scenario-panel">
            <div class="nbis-panel__header"><h3>Illustrative EV / revenue scenarios</h3><span class="nbis-pill">Assumptions</span></div>
            <p id="nbis-scenario-note" class="nbis-muted">Loading assumptions…</p>
            <div id="nbis-scenario-table" class="nbis-table-wrap"><div class="nbis-empty">Loading…</div></div>
          </article>
        </div>
      </section>

      <section id="risks" class="nbis-section" aria-labelledby="risks-title">
        <div class="nbis-section__heading">
          <div>
            <p class="nbis-eyebrow">06 / Decision pressure</p>
            <h2 id="risks-title">Risks, catalysts, and evidence gaps</h2>
          </div>
          <p class="nbis-section__note">Automatic flags point to questions worth verifying; they do not predict outcomes.</p>
        </div>
        <div class="nbis-two-column nbis-two-column--wide">
          <article class="nbis-panel nbis-risk-panel">
            <div class="nbis-panel__header"><h3>Risk flags</h3><span class="nbis-muted">Rules-based</span></div>
            <div id="nbis-risks"><div class="nbis-empty">Loading risk flags…</div></div>
          </article>
          <article class="nbis-panel nbis-catalyst-panel">
            <div class="nbis-panel__header"><h3>Catalysts and checks</h3><span class="nbis-muted">Evidence to watch</span></div>
            <div id="nbis-catalysts"><div class="nbis-empty">Loading catalysts…</div></div>
          </article>
        </div>
      </section>

      <section id="filings" class="nbis-section" aria-labelledby="filings-title">
        <div class="nbis-section__heading">
          <div>
            <p class="nbis-eyebrow">07 / Primary sources</p>
            <h2 id="filings-title">SEC filings and recent headlines</h2>
          </div>
          <p class="nbis-section__note">Filings are linked directly to EDGAR. Headlines are discovery aids, not verified facts.</p>
        </div>
        <article class="nbis-panel nbis-table-panel">
          <div class="nbis-panel__header"><h3>Recent SEC filings</h3><span id="nbis-filing-count" class="nbis-muted">Loading…</span></div>
          <div id="nbis-filings-table" class="nbis-table-wrap"><div class="nbis-empty">Loading filings…</div></div>
        </article>
        <div class="nbis-two-column nbis-two-column--wide">
          <article class="nbis-panel nbis-table-panel">
            <div class="nbis-panel__header"><h3>SEC reported facts</h3><span class="nbis-muted">Structured EDGAR facts</span></div>
            <div id="nbis-sec-facts" class="nbis-table-wrap"><div class="nbis-empty">Loading EDGAR facts…</div></div>
          </article>
          <article class="nbis-panel nbis-table-panel">
            <div class="nbis-panel__header"><h3>Recent headlines</h3><span class="nbis-muted">Provider discovery feed</span></div>
            <div id="nbis-news" class="nbis-news-list"><div class="nbis-empty">Loading headlines…</div></div>
          </article>
        </div>
      </section>

      <section id="sources" class="nbis-section nbis-section--last" aria-labelledby="sources-title">
        <div class="nbis-section__heading">
          <div>
            <p class="nbis-eyebrow">Method</p>
            <h2 id="sources-title">Data notes and sources</h2>
          </div>
        </div>
        <div id="nbis-sources" class="nbis-source-grid">
          {profile.sources.map((source) => (
            <a class="nbis-source-card nbis-panel" href={source.url} target="_blank" rel="noopener">
              <strong>{source.label} ↗</strong>
              <span>{source.note}</span>
            </a>
          ))}
        </div>
        <div class="nbis-disclaimer">
          Research and education only — not investment advice. Data can be delayed, incomplete, restated, or wrong. Verify material claims against the latest company filing and do not treat automated scores, scenarios, or consensus estimates as guaranteed outcomes.
        </div>
      </section>
    </main>
    {
      showFooterAd && (
        <div class="container nbis-ad-container">
          <AdSlot placement="footer" label="Sponsored" class="ad-slot--footer" />
        </div>
      )
    }
  </div>
</BaseLayout>

<script src="../client/nbis-dashboard.ts"></script>

<style is:global>
  @import "../styles/nbis.css";
</style>
