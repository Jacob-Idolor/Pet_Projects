---
import BaseLayout from "../layouts/BaseLayout.astro";
import LiveStatus from "../components/LiveStatus.astro";
import DayMoodBanner from "../components/DayMoodBanner.astro";
import WatchlistBoard from "../components/WatchlistBoard.astro";
import GroupSubmissions from "../components/GroupSubmissions.astro";
import AdSlot from "../components/AdSlot.astro";
import { meta, stocks } from "../data/watchlist";

const description =
  meta.tagline ||
  "Group watchlist with live quotes, technicals, and a clean mobile layout — Stocks Radar.";
---

<BaseLayout title={meta.groupName} description={description}>
  <div class="app-shell">
    <LiveStatus />
    <DayMoodBanner />
    <section class="hero container">
      <div class="hero-copy">
        <p class="hero-brand">Stocks Radar</p>
        <h1>{meta.groupName}</h1>
        <p class="tagline desktop-only">{meta.tagline}</p>
      </div>
      <dl class="hero-kpis desktop-only" aria-label="Watchlist summary">
        <div class="hero-kpi">
          <dt>Tickers</dt>
          <dd class="mono">{stocks.length}</dd>
        </div>
        <div class="hero-kpi">
          <dt>Feed</dt>
          <dd>Live quotes</dd>
        </div>
        <div class="hero-kpi">
          <dt>Scope</dt>
          <dd>Group list</dd>
        </div>
      </dl>
    </section>
    <div class="container">
      <AdSlot placement="hero" label="Sponsored — top" />
    </div>
    <div class="container board-stage">
      <WatchlistBoard />
      <AdSlot placement="board" label="Sponsored — watchlist" class="ad-slot--after-board" />
      <div class="secondary-panels desktop-only">
        <GroupSubmissions />
      </div>
      <AdSlot placement="footer" label="Sponsored — footer" />
    </div>
  </div>
</BaseLayout>
