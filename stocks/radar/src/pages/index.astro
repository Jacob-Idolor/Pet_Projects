---
import BaseLayout from "../layouts/BaseLayout.astro";
import StockSection from "../components/StockSection.astro";
import HoldingsUpload from "../components/HoldingsUpload.astro";
import { meta, stocks } from "../data/watchlist";

const ownedCount = stocks.filter((s) => s.category === "owned").length;
const targetCount = stocks.filter((s) => s.category === "targets").length;
const watchCount = stocks.filter((s) => s.category === "watching").length;
const symbols = [...new Set(stocks.map((s) => s.symbol))];
---

<BaseLayout title={meta.groupName}>
  <section class="hero container">
    <h1>{meta.groupName}</h1>
    <p class="tagline">{meta.tagline}</p>
    <div class="hero-stats">
      <span class="stat-pill"><strong>{ownedCount}</strong> holding{ownedCount === 1 ? "" : "s"}</span>
      <span class="stat-pill"><strong>{targetCount}</strong> price target{targetCount === 1 ? "" : "s"}</span>
      <span class="stat-pill"><strong>{watchCount}</strong> on watch</span>
      <span class="stat-pill">Updated {meta.lastUpdated}</span>
    </div>
  </section>

  <div class="container">
    <HoldingsUpload />

    <StockSection category="owned" />
    <StockSection category="targets" />
    <StockSection category="watching" />
  </div>
</BaseLayout>

<script define:vars={{ symbols }}>
  async function fetchQuotes(symbols) {
    if (!symbols.length) return;

    const quotes = {};

    await Promise.all(
      symbols.map(async (symbol) => {
        try {
          const res = await fetch(
            `https://query1.finance.yahoo.com/v8/finance/chart/${encodeURIComponent(symbol)}?interval=1d&range=1d`,
            { headers: { Accept: "application/json" } }
          );
          if (!res.ok) return;
          const data = await res.json();
          const meta = data?.chart?.result?.[0]?.meta;
          if (!meta?.regularMarketPrice) return;

          quotes[symbol] = {
            price: meta.regularMarketPrice,
            changePct: meta.regularMarketChangePercent ?? null,
          };
        } catch {
          /* offline or CORS — fall back to static prices in watchlist.ts */
        }
      })
    );

    if (Object.keys(quotes).length) {
      document.dispatchEvent(new CustomEvent("radar:quotes", { detail: quotes }));
    }
  }

  fetchQuotes(symbols);
  setInterval(() => fetchQuotes(symbols), 60_000);
</script>
