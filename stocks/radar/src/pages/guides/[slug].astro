---
import Layout from '../../layouts/PersonalLayout.astro';
import { guides } from '../../data/guides';
export function getStaticPaths() { return guides.map(guide => ({ params: { slug: guide.slug }, props: { guide } })); }
const { guide } = Astro.props;
const relatedGuides = guides.filter(item => item.slug !== guide.slug);
const formatDate = (value: string) => new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(`${value}T00:00:00Z`));
---
<Layout title={guide.title} description={guide.description} active="Guides" article={{ publishedAt: guide.publishedAt, modifiedAt: guide.modifiedAt }}>
  <article class="article">
    <p class="eyebrow">{guide.category}</p>
    <h1>{guide.title}</h1>
    <p class="meta">By <a href="/about" rel="author">Jacob</a> &middot; Published <time datetime={guide.publishedAt}>{formatDate(guide.publishedAt)}</time>{guide.modifiedAt !== guide.publishedAt && <> &middot; Updated <time datetime={guide.modifiedAt}>{formatDate(guide.modifiedAt)}</time></>} &middot; About {guide.minutes} minutes</p>
    <p class="lead">{guide.intro}</p>
    {guide.sections.map(section => <section><h2>{section.title}</h2>{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}{'items' in section && section.items && <ul>{section.items.map(item => <li>{item}</li>)}</ul>}</section>)}
    <aside class="callout"><h2 style="margin-top:0;font-size:1.3rem">One small next step</h2><p>{guide.takeaway}</p></aside>
    <p class="small">General educational guidance. Adapt it to your environment, permissions and risk. Examples are illustrative unless identified as project history.</p>
    <section aria-labelledby="related-title"><h2 id="related-title">Keep exploring</h2><ul>{relatedGuides.map(item => <li><a href={`/guides/${item.slug}`}>{item.title}</a><p class="small">{item.description}</p></li>)}</ul></section>
    <a href="/guides">&larr; Back to all guides</a>
  </article>
</Layout>
