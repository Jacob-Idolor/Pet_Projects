---
import Layout from '../../layouts/PersonalLayout.astro';
import { guides } from '../../data/guides';
export function getStaticPaths() { return guides.map(guide => ({ params: { slug: guide.slug }, props: { guide } })); }
const { guide } = Astro.props;
---
<Layout title={guide.title} description={guide.description} active="Guides"><article class="article"><p class="eyebrow">{guide.category}</p><h1>{guide.title}</h1><p class="meta">Jacob · October 5, 2026 · About {guide.minutes} minutes</p><p class="lead">{guide.intro}</p>{guide.sections.map(section => <section><h2>{section.title}</h2>{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}{'items' in section && section.items && <ul>{section.items.map(item => <li>{item}</li>)}</ul>}</section>)}<aside class="callout"><h2 style="margin-top:0;font-size:1.3rem">One small next step</h2><p>{guide.takeaway}</p></aside><p class="small">General educational guidance. Adapt it to your environment, permissions and risk. Examples are illustrative unless identified as project history.</p><a href="/guides.html">← Back to all guides</a></article></Layout>
