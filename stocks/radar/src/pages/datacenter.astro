---
import DatacenterLayout from "../layouts/DatacenterLayout.astro";
import { datacenterAsset } from "../lib/datacenter-assets";

const base = import.meta.env.BASE_URL;
const dcBase = `${base}datacenter/`.replace(/\/{2,}/g, "/").replace(":/", "://");
const scripts = ["static-api.js", "app.js", "datacenter.js", "rackexplorer.js"].map(
  (name) => `${dcBase}${datacenterAsset(name)}`
);
---

<DatacenterLayout
  title="AI Data Center"
  description="Organize the AI data-center buildout into six layers with market snapshots, scoring, map, and research prompts."
>
  <div class="dc-shell">
    <section class="hero container">
      <div class="hero-copy">
        <p class="hero-brand">StocksWatch</p>
        <h1>AI Data Center</h1>
        <p class="tagline">
          Six layers of the buildout — land → power → cooling → compute → networking → software.
          Snapshot prices from Yahoo; not live trading advice.
        </p>
      </div>
      <dl class="hero-kpis" aria-label="Screener summary" id="heroKpis">
        <div class="hero-kpi">
          <dt>Universe</dt>
          <dd class="mono" id="kpiNames">—</dd>
        </div>
        <div class="hero-kpi">
          <dt>Layers</dt>
          <dd class="mono">6</dd>
        </div>
        <div class="hero-kpi desktop-only">
          <dt>Coverage</dt>
          <dd class="mono" id="kpiOk">—</dd>
        </div>
      </dl>
    </section>

    <div class="container board-stage">
      <nav class="mainnav" id="mainnav" aria-label="View">
        <button type="button" data-mode="screener" class="active">Screener</button>
        <button type="button" data-mode="datacenter">Map</button>
        <button type="button" data-mode="rack">Rack</button>
        <button type="button" data-mode="analyst">Analyst</button>
        <button type="button" data-mode="lookup">Lookup</button>
      </nav>
      <p class="mode-purpose" id="modePurpose">
        Screener — rank holdings by valuation, momentum, quality, and composite score
      </p>

      <div class="board-chrome">
        <div class="board-header">
          <div class="board-heading">
            <p class="board-eyebrow">Thematic board</p>
            <h2>What we’re screening</h2>
            <p class="board-subtitle">
              Expand a row for score breakdown + headlines. Filters and columns stay sticky.
            </p>
          </div>
          <div class="board-actions">
            <div class="search-wrap">
              <input
                id="search"
                type="search"
                class="search-input"
                placeholder="Search ticker, name, or tag…"
                autocomplete="off"
              />
            </div>
            <button type="button" id="refresh" class="btn-refresh" title="Reload the latest Yahoo snapshot">
              Refresh
            </button>
          </div>
        </div>

        <div class="filterbar" id="filterbar">
          <div class="seg" id="viewToggle" role="tablist" aria-label="View">
            <button type="button" data-view="layers" class="active">By layer</button>
            <button type="button" data-view="flat">All names</button>
          </div>
          <div class="exposure-filter" id="exposureFilter" aria-label="Exposure filter">
            <span class="flabel">Exposure</span>
            <button type="button" data-exp="pure">Pure</button>
            <button type="button" data-exp="high">High</button>
            <button type="button" data-exp="moderate">Moderate</button>
            <button type="button" data-exp="diversified">Diversified</button>
          </div>
          <button type="button" id="filtersBtn" class="filters-btn" aria-expanded="false">Filters</button>
          <span class="flabel cols-label">Columns</span>
          <div class="seg" id="colset" role="tablist" aria-label="Column set">
            <button type="button" data-cs="valuation" class="active">Valuation</button>
            <button type="button" data-cs="momentum">Momentum</button>
            <button type="button" data-cs="quality">Quality</button>
            <button type="button" data-cs="consensus">Consensus</button>
            <button type="button" data-cs="trends">Trends</button>
          </div>
          <span class="flabel cols-label" title="Rank score factors against the whole universe, or same-layer peers">
            Score vs
          </span>
          <div class="seg" id="scoreMode" role="tablist" aria-label="Score basis">
            <button type="button" data-sm="universe" class="active">Universe</button>
            <button type="button" data-sm="layer">Layer</button>
          </div>
          <div class="movers" id="movers"></div>
        </div>

        <div class="filters-panel hidden" id="filtersPanel"></div>

        <div class="live-status statusbar" id="statusbar" role="status">
          <span class="live-status__dot" id="statusDot" aria-hidden="true"></span>
          <span id="status">Loading universe…</span>
          <span id="meta" class="muted"></span>
        </div>
      </div>

      <div class="focus-banner hidden" id="focusBanner"></div>
      <div class="alerts hidden" id="alerts"></div>

      <main id="layers"><div class="loading">Loading the latest market snapshot…</div></main>

      <section class="datacenter hidden" id="datacenter">
        <div class="dc-intro">
          <p class="board-eyebrow">Interactive map</p>
          <h2>The AI factory, in cross-section</h2>
          <p class="muted">
            Hover a zone to preview it, click to pin details, then jump into that layer’s stocks.
          </p>
        </div>
        <div class="dc-stage">
          <div class="dc-svgwrap" id="dcSvgWrap"></div>
          <aside class="dc-panel" id="dcPanel"></aside>
        </div>
        <div class="dc-legend" id="dcLegend"></div>
      </section>

      <section class="lookup hidden" id="lookup">
        <div class="lk-head">
          <p class="board-eyebrow">Lookup</p>
          <h2>Pin a universe ticker</h2>
          <p class="muted">
            Search names already in the curated list. To expand the shared universe, edit
            <code>src/data/datacenter-universe.json</code> and redeploy.
          </p>
        </div>
        <div class="lk-bar">
          <input
            id="lkTicker"
            type="search"
            class="search-input"
            placeholder="e.g. VRT, ETN, CRDO…"
            autocomplete="off"
          />
          <button type="button" id="lkGo" class="btn-refresh">Look up</button>
        </div>
        <div class="lk-result" id="lkResult"></div>
        <div class="lk-added" id="lkAdded"></div>
      </section>

      <section class="analyst hidden" id="analyst">
        <div class="an-head">
          <p class="board-eyebrow">Research</p>
          <h2>AI Analyst</h2>
          <p class="muted">
            Builds a ready-to-paste prompt from this page’s snapshot (financials, score, peers,
            headlines). <span id="anKeyNote"></span>
          </p>
        </div>
        <div class="an-bar">
          <label class="an-pick">
            Company
            <select id="anTicker"></select>
          </label>
          <div class="an-reports" id="anReports"></div>
        </div>
        <div class="an-output" id="anOutput"><div class="muted">Choose a report above to begin.</div></div>
      </section>

      <section class="rackx hidden" id="rackexplorer">
        <div class="rackx-head">
          <div>
            <p class="board-eyebrow">Build hierarchy</p>
            <h2>Inside the rack</h2>
            <p class="muted">
              From data-hall row down to GPU die &amp; HBM. Scroll, use the buttons, or click a stage.
            </p>
          </div>
          <div class="rackx-rail" id="rxRail"></div>
        </div>
        <div class="rackx-stage">
          <div class="rackx-svgwrap" id="rxStage"></div>
          <aside class="rackx-info" id="rxInfo"></aside>
        </div>
      </section>
    </div>

    <footer class="site-footer">
      <div class="container">
        <p>
          Part of <a href={base}>StocksWatch</a> — Yahoo Finance snapshots · research only, not advice.
          Edit <code>src/data/datacenter-universe.json</code> to change holdings.
        </p>
        <p class="disclaimer">
          Interactive map is SVG (no photo CDN weight). Optional reference stills + licenses:
          <code>docs/datacenter-reference-photos/</code>.
        </p>
      </div>
    </footer>
  </div>

  <script is:inline src={scripts[0]}></script>
  <script is:inline src={scripts[1]}></script>
  <script is:inline src={scripts[2]}></script>
  <script is:inline src={scripts[3]}></script>
</DatacenterLayout>
