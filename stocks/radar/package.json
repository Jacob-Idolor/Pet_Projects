{
  "name": "stocks-radar",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "bundle:watchlist": "node scripts/bundle-watchlist.mjs",
    "sync:tokens": "node scripts/sync-tokens.mjs",
    "hash:datacenter": "node scripts/hash-datacenter-assets.mjs",
    "config:validate": "node scripts/validate-config.mjs",
    "config:validate:prod": "node scripts/validate-config.mjs --production",
    "screener:schema": "node scripts/validate-screener-schema.mjs",
    "adsense:checklist": "node scripts/adsense-review-checklist.mjs",
    "test": "node --test tests/**/*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "astro sync && tsc --noEmit",
    "dev": "npm run sync:tokens && npm run hash:datacenter && npm run bundle:watchlist && astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "rebuild": "npm run prebuild && npm run build && npm run preview",
    "import-csv": "node scripts/csv-to-watchlist.mjs",
    "update-quotes": "node scripts/fetch-quotes.mjs",
    "update-outlook": "node scripts/fetch-outlook.mjs",
    "update-screener": "python scripts/fetch-screener.py && node scripts/write-dc-movers.mjs",
    "dc-movers": "node scripts/write-dc-movers.mjs",
    "freshness": "node scripts/check-live-freshness.mjs",
    "freshness:live": "node scripts/check-live-freshness.mjs --url",
    "seo": "node scripts/write-seo-files.mjs",
    "health": "node scripts/write-health.mjs",
    "digest": "node scripts/daily-digest.mjs",
    "alerts": "node scripts/signal-alerts.mjs",
    "go-live:preflight": "node scripts/go-live-preflight.mjs",
    "prebuild": "npm run config:validate && npm run sync:tokens && npm run hash:datacenter && npm run bundle:watchlist && node scripts/fetch-quotes.mjs && node scripts/fetch-screener-soft.mjs && npm run screener:schema && node scripts/write-build-meta.mjs && node scripts/write-seo-files.mjs && node scripts/write-health.mjs",
    "update-quotes:otel": "OTEL_EXPORTER_OTLP_ENDPOINT=${OTEL_EXPORTER_OTLP_ENDPOINT:-http://localhost:4318} OTEL_TRACES_EXPORTER=${OTEL_TRACES_EXPORTER:-console} node scripts/fetch-quotes.mjs",
    "alerts:otel": "OTEL_EXPORTER_OTLP_ENDPOINT=${OTEL_EXPORTER_OTLP_ENDPOINT:-http://localhost:4318} OTEL_TRACES_EXPORTER=${OTEL_TRACES_EXPORTER:-console} node scripts/signal-alerts.mjs"
  },
  "dependencies": {
    "astro": "^7.1.3"
  },
  "optionalDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.43.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.1",
    "@types/node": "^26.1.2",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.3"
  }
}
