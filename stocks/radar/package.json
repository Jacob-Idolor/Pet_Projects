{
  "name": "stocks-radar",
  "type": "module",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "sync:tokens": "node scripts/ops/sync-tokens.mjs",
    "hash:datacenter": "node scripts/ops/hash-datacenter-assets.mjs",
    "config:validate": "node scripts/ops/validate-config.mjs",
    "config:validate:prod": "node scripts/ops/validate-config.mjs --production",
    "screener:schema": "node scripts/ops/validate-screener-schema.mjs",
    "nbis:schema": "node scripts/ops/validate-nbis-schema.mjs",
    "adsense:checklist": "node scripts/ops/adsense-review-checklist.mjs",
    "product:pack": "python scripts/ops/package-workflow-pack.py",
    "product:test": "python -m unittest discover -s tests/python -p test_workflow_pack.py",
    "test": "node --test tests/**/*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "astro sync && tsc --noEmit",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "rebuild": "npm run build && npm run preview",
    "update-screener": "python scripts/fetch/fetch-screener.py && node scripts/fetch/write-dc-movers.mjs",
    "update-nbis": "python scripts/fetch/fetch-nbis.py",
    "nbis:snapshot": "node scripts/fetch/fetch-nbis-soft.mjs",
    "dc-movers": "node scripts/fetch/write-dc-movers.mjs",
    "freshness": "node scripts/ops/check-live-freshness.mjs",
    "freshness:live": "node scripts/ops/check-personal-live.mjs",
    "security:dist": "node scripts/ops/check-dist-security.mjs",
    "security:deps": "npm audit --audit-level=high",
    "verify:dist": "node scripts/ops/verify-dist.mjs",
    "policy:dist": "node scripts/ops/check-personal-policy.mjs",
    "seo": "node scripts/ops/write-seo-files.mjs",
    "health": "node scripts/ops/write-health.mjs",
    "prebuild": "node scripts/ops/write-build-meta.mjs && node scripts/ops/write-seo-files.mjs",
    "postbuild": "node scripts/ops/prepare-release.mjs",
    "nbis:quality": "node scripts/ops/validate-nbis-schema.mjs --fresh"
  },
  "dependencies": {
    "astro": "^7.3.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.53.1",
    "@types/node": "^26.6.4",
    "saxes": "6.0.0",
    "typescript": "^7.0.2",
    "wrangler": "4.146.0"
  },
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
