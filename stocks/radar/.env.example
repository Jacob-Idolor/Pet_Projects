# Copy to .env for local overrides (never commit .env)

# Site URL used for SEO canonical/sitemap (also set in CI from CloudFront or custom domain)
# Production: STOCKS_RADAR_SITE=https://stockswatch.cc
STOCKS_RADAR_SITE=http://localhost:4321
STOCKS_RADAR_BASE=/

# --- Group suggestions (Web3Forms — free email delivery) ---
# Create a key at https://web3forms.com (free tier). Leave empty for local-only
# IndexedDB saves (no email). Safe to expose: Web3Forms access keys are public.
# GitHub Actions: set repository variable or secret PUBLIC_WEB3FORMS_ACCESS_KEY
# and pass it into the deploy build env (see stocks-radar-deploy.yml).
PUBLIC_WEB3FORMS_ACCESS_KEY=

# --- AdSense (publisher) — policy: ADSENSE.md ---
# Units only AFTER the watchlist (board + footer). Turn Auto ads OFF in AdSense console.
# Live ads also need custom domain (seo.requireCustomDomainForAds) + ≥5 watchlist tickers.
PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
PUBLIC_ADSENSE_ENABLED=true

# Optional: force preview boxes even with CLIENT set (useful for visual QA; never in CI prod)
# PUBLIC_ADSENSE_PREVIEW=true

# Prefer BOARD + FOOTER. HERO slot is unused unless PUBLIC_ADSENSE_ALLOW_HERO=true
# (still rendered after content — not in the page hero).
PUBLIC_ADSENSE_SLOT_BOARD=
PUBLIC_ADSENSE_SLOT_FOOTER=
PUBLIC_ADSENSE_SLOT_HERO=
# PUBLIC_ADSENSE_ALLOW_HERO=true

# Optional: AdSense site verification (Sites → get code → google-adsense-account meta content)
# PUBLIC_ADSENSE_VERIFY_META=ca-pub-XXXXXXXXXXXXXXXX

# --- Environment ---
# This project ships one live site (stockswatch.cc). CI sets STOCKS_RADAR_ENV=production.
# Local npm run dev stays a laptop preview — there is no separate staging host.
# STOCKS_RADAR_ENV=production

# --- OpenTelemetry (optional — CI / laptop scripts only; never required for the static site) ---
# Leave unset for zero telemetry. Local lab: cd opentelemetry && make stack-up
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_EXPORTER=console
# OTEL_SDK_DISABLED=true

# Product knobs (staleness, features, board defaults) live in:
#   src/data/site-settings.json
# See PRODUCTION.md for the full config model.
