# Copy to .env for local overrides (never commit .env)

# Site URL used for SEO canonical/sitemap (also set in CI from CloudFront or custom domain)
# Production: STOCKS_RADAR_SITE=https://stockswatch.cc
STOCKS_RADAR_SITE=http://localhost:4321
STOCKS_RADAR_BASE=/

# --- AdSense (publisher) ---
# Get these in AdSense → Ads → By ad unit / Account → Account information
# Leave CLIENT empty to hide live ads in production builds.
# Full flow: ADSENSE.md + domain: DOMAIN.md (stockswatch.cc)
PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
PUBLIC_ADSENSE_ENABLED=true

# Optional: force preview boxes even with CLIENT set (useful for visual QA)
# PUBLIC_ADSENSE_PREVIEW=true

# Create display units in AdSense, then paste ad unit IDs (numbers only)
PUBLIC_ADSENSE_SLOT_HERO=
PUBLIC_ADSENSE_SLOT_BOARD=
PUBLIC_ADSENSE_SLOT_FOOTER=

# Optional: AdSense site verification (Sites → get code → google-adsense-account meta content)
# PUBLIC_ADSENSE_VERIFY_META=ca-pub-XXXXXXXXXXXXXXXX

# --- Environment ---
# development | staging | production (affects config:validate --production)
# STOCKS_RADAR_ENV=development

# --- OpenTelemetry (optional — CI / laptop scripts only) ---
# Leave unset for zero telemetry. Local lab: cd opentelemetry && make stack-up
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_EXPORTER=console
# OTEL_SDK_DISABLED=true

# Product knobs (staleness, features, board defaults) live in:
#   src/data/site-settings.json
# See PRODUCTION.md for the full config model.
